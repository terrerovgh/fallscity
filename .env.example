# Build variables (Cloudflare build settings). The contact form renders only when both are set.
PUBLIC_TURNSTILE_SITE_KEY=
PUBLIC_INQUIRY_ENABLED=false

# Worker secrets (Cloudflare secrets in production, .dev.vars for wrangler dev). Never PUBLIC_*.
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
INQUIRY_TO_EMAIL=
INQUIRY_FROM_EMAIL=
