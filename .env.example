# Worker runtime variables: Cloudflare > Workers > fallscity > Settings > Variables and Secrets
# (NOT build variables). For `wrangler dev`, put them in .dev.vars (ignored by git).
# The form appears by itself once the site key and all four secrets exist; no rebuild needed.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
INQUIRY_TO_EMAIL=
INQUIRY_FROM_EMAIL=
# Optional: set to false to hide the form without removing the secrets.
PUBLIC_INQUIRY_ENABLED=true
