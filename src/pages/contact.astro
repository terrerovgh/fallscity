---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ContactForm from '../components/ContactForm.astro';

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Contact', path: '/contact/' },
];
---

<BaseLayout
  title="Request a Website Quote in Louisville | Falls City Dev Studio"
  description="Tell Falls City Dev Studio about your Louisville business website, redesign, SEO foundations, domain, hosting, SSL, or maintenance project."
  pageType="ContactPage"
  breadcrumbs={breadcrumbs}
>
  <PageHero
    breadcrumbs={breadcrumbs}
    eyebrow="Start a project"
    title="Let’s talk about what your website needs to do."
    copy="Share a few details about your business and project. You don’t need a technical brief, and any context you add makes the first conversation more useful."
  />

  <section class="section section--bright" aria-labelledby="inquiry-heading">
    <div class="container contact-layout">
      <aside class="contact-aside" aria-label="Before you inquire">
        <div class="contact-aside__block">
          <h2>What to include</h2>
          <p>What your business does, whether you have a website now, and what a better result would look like.</p>
        </div>
        <div class="contact-aside__block">
          <h2>What happens next</h2>
          <p>We read your details and get back to you to talk about whether we’re a good fit and what the project would involve.</p>
        </div>
        <div class="contact-aside__block">
          <h2>What we offer</h2>
          <p>Website design and development, SEO foundations, domain and hosting setup, SSL, and website maintenance.</p>
        </div>
      </aside>
      <div>
        <h2 class="sr-only" id="inquiry-heading">Project inquiry form</h2>
        <ContactForm />
      </div>
    </div>
  </section>
</BaseLayout>
