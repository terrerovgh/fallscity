---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CallToAction from '../components/CallToAction.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { processSteps } from '../data/process';

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Process', path: '/process/' },
];
---

<BaseLayout
  title="Our Website Design Process | Falls City Dev Studio"
  description="See how Falls City Dev Studio takes Louisville business websites from an initial conversation through scope, design, development, review, launch, and support."
  breadcrumbs={breadcrumbs}
>
  <PageHero
    breadcrumbs={breadcrumbs}
    eyebrow="The process"
    title="A clear path from idea to working website."
    copy="Every project goes through the same five stages. At each one you’ll know what we’re working on and what we need from you."
  >
    <a class="text-link" href="/contact/">Start with a conversation</a>
  </PageHero>

  <section class="section--bright" aria-label="Project steps">
    <div class="container">
      <ol class="process-list">
        {processSteps.map((step) => (
          <li class="process-step reveal-on-scroll">
            <span class="process-step__number" aria-hidden="true">{step.number}</span>
            <div>
              <h2>{step.title}</h2>
              <p class="lede">{step.summary}</p>
              <p class="process-step__description">{step.description}</p>
            </div>
            <div class="process-step__role">
              <h3>Your part</h3>
              <p>{step.clientRole}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="collaboration-heading">
    <div class="container">
      <SectionHeading
        id="collaboration-heading"
        eyebrow="Working together"
        title="What helps a project go smoothly."
        copy="We handle the design and technical work. A few habits on your side make it easier to keep the site in line with your business."
      />
      <div class="service-grid">
        <article class="service-card service-card--plain reveal-on-scroll">
          <h3>Share real details</h3>
          <p>Real service details, customer questions, and examples from your business lead to a more useful website than generic industry copy.</p>
        </article>
        <article class="service-card service-card--plain reveal-on-scroll">
          <h3>Send feedback together</h3>
          <p>Collect comments from everyone who has a say and send them in one go. Revisions move faster when the feedback doesn’t conflict.</p>
        </article>
        <article class="service-card service-card--plain reveal-on-scroll">
          <h3>Talk about scope changes</h3>
          <p>If a new idea changes the work, we’ll discuss it and agree on it before it gets added.</p>
        </article>
        <article class="service-card service-card--plain reveal-on-scroll">
          <h3>Plan for after launch</h3>
          <p>Websites need occasional updates. Ongoing support can be added if you want someone to handle them for you.</p>
        </article>
      </div>
    </div>
  </section>

  <CallToAction title="Ready to start a conversation?" copy="You don’t need a finished brief. A first conversation is usually enough to work out what your website needs to do." />
</BaseLayout>
