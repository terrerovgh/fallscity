---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import FaqList from '../../components/FaqList.astro';
import CallToAction from '../../components/CallToAction.astro';
import { site } from '../../config/site';
import { faqsEs, processStepsEs, servicesEs } from '../../data/es';

// /es/ is the Spanish counterpart of the homepage; both declare the same set
// of hreflang alternates so Google pairs them.
const alternates = [
  { hreflang: 'en-US', path: '/' },
  { hreflang: 'es-US', path: '/es/' },
  { hreflang: 'x-default', path: '/' },
];
---

<BaseLayout
  title="Diseño de Páginas Web en Louisville, KY | Falls City Dev Studio"
  description="Diseño de páginas web en español para pequeños negocios de Louisville y Kentucky: diseño y desarrollo, bases de SEO, dominio, hosting, SSL y mantenimiento."
  lang="es-US"
  alternates={alternates}
>
  <PageHero
    eyebrow="Diseño web en Louisville, Kentucky"
    title="Diseño de páginas web en Louisville, KY, en español."
    copy="Diseñamos y construimos páginas web para pequeños negocios de Louisville y trabajamos a distancia con negocios de todo Kentucky. Le atendemos en español de principio a fin."
  >
    <div class="button-row">
      <a class="button" href={`mailto:${site.email}`}>Escríbanos en español</a>
      <a class="text-link" href="/" hreflang="en-US" lang="en-US">English version</a>
    </div>
  </PageHero>

  <section class="section--bright" aria-label="Servicios">
    <div class="container service-details">
      {servicesEs.map((service) => (
        <article class="service-detail reveal-on-scroll">
          <div>
            <div class="service-detail__header">
              <h2>{service.title}</h2>
              <p class="service-detail__description">{service.summary}</p>
            </div>
            <div class="service-detail__body">
              <h3>Puede incluir</h3>
              <ul class="check-list">{service.details.map((item) => <li>{item}</li>)}</ul>
            </div>
            <a class="text-link" href={service.href} hreflang="en-US">Más detalles (en inglés)<span class="sr-only">: {service.title}</span></a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section section--ink" aria-labelledby="proceso-heading">
    <div class="container">
      <SectionHeading
        id="proceso-heading"
        eyebrow="Cómo trabajamos"
        title="De la primera conversación a su página publicada."
        copy="Cada proyecto sigue los mismos cinco pasos. Usted revisa la página real mientras se construye y siempre sabe qué sigue."
      />
      <ol class="process-preview">
        {processStepsEs.map((step) => (
          <li class="process-preview__step reveal-on-scroll">
            <span class="process-preview__number">{step.number}</span>
            <strong>{step.title}</strong>
            <p>{step.summary}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section--bright" aria-labelledby="por-que-heading">
    <div class="container split-feature">
      <div class="split-feature__sticky">
        <p class="eyebrow">Por qué Falls City</p>
        <h2 class="display" id="por-que-heading">Un estudio pequeño que solo hace páginas web.</h2>
        <p class="lede">No necesita una agencia grande ni un paquete de servicios que nunca va a usar. Necesita una página que represente bien su negocio y alguien que le explique el trabajo en su idioma.</p>
        <a class="text-link" href="/#work" hreflang="en-US">Vea páginas que hemos hecho</a>
      </div>
      <div class="principle-list">
        <div class="principle reveal-on-scroll">
          <h3>Su mensaje primero</h3>
          <p>Quien visita su página debe entender en segundos qué hace usted y cómo contactarle. El diseño está para apoyar eso.</p>
        </div>
        <div class="principle reveal-on-scroll">
          <h3>Los detalles, resueltos</h3>
          <p>La página se adapta a cualquier pantalla, carga rápido, el código está limpio y funciona con teclado y lectores de pantalla.</p>
        </div>
        <div class="principle reveal-on-scroll">
          <h3>Explicado en español claro</h3>
          <p>Sabrá qué se está construyendo, qué necesitamos de usted y cómo encajan las partes técnicas, sin palabras complicadas.</p>
        </div>
        <div class="principle reveal-on-scroll">
          <h3>Su página, en el idioma de sus clientes</h3>
          <p>Si sus clientes hablan inglés y español, su página puede estar en los dos idiomas.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="preguntas-heading">
    <div class="container faq-layout">
      <div class="faq-layout__intro">
        <p class="eyebrow">Preguntas frecuentes</p>
        <h2 class="display" id="preguntas-heading">Lo que nos preguntan primero.</h2>
        <p class="lede">Si tiene otra pregunta, escríbanos a <a href={`mailto:${site.email}`}>{site.email}</a>.</p>
      </div>
      <FaqList faqs={faqsEs} />
    </div>
  </section>

  <CallToAction
    eyebrow="Empecemos"
    title="¿Tiene un proyecto de página web en mente?"
    copy="Cuéntenos qué hace su negocio y qué necesita de su página web. Puede escribir en español en el formulario o por correo."
    buttonLabel="Cuéntenos de su proyecto"
  />
</BaseLayout>
