---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CallToAction from '../components/CallToAction.astro';

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'About', path: '/about/' },
];
---

<BaseLayout
  title="About Our Louisville Web Studio | Falls City Dev Studio"
  description="Falls City Dev Studio is a Louisville-based web development studio focused on clear, professional, fast websites and practical support for local small businesses."
  pageType="AboutPage"
  breadcrumbs={breadcrumbs}
>
  <PageHero
    breadcrumbs={breadcrumbs}
    eyebrow="About the studio"
    title="A Louisville web studio for small businesses."
    copy="Falls City Dev Studio designs and builds websites for small businesses, independent professionals, and service providers who need a site that does more for them."
  >
    <a class="text-link" href="/services/">Explore our services</a>
  </PageHero>

  <section class="section section--bright" aria-labelledby="studio-statement">
    <div class="container">
      <p class="eyebrow">What we design for</p>
      <h2 class="about-statement" id="studio-statement">A good website makes your business easier to <em>understand, trust, and contact.</em> Every design and technical decision should help with that.</h2>
    </div>
  </section>

  <section class="section" aria-labelledby="values-heading">
    <div class="container">
      <SectionHeading
        id="values-heading"
        eyebrow="How we work"
        title="How we make decisions on a project."
        copy="Adding more technology doesn’t make a business website better. What matters is whether it works for you and for your customers."
      />
      <div class="values-grid">
        <article class="value-card reveal-on-scroll">
          <h3>Useful over trendy</h3>
          <p>A layout or animation stays only if it helps visitors find information or take action. Style should never make the site harder to use.</p>
        </article>
        <article class="value-card reveal-on-scroll">
          <h3>The basics are required</h3>
          <p>Clean structure, accessibility, layouts that work on any screen, fast pages, and search fundamentals are part of every build from the first day.</p>
        </article>
        <article class="value-card reveal-on-scroll">
          <h3>Clear about scope</h3>
          <p>We focus on websites and the technical work around them. You’ll know what is included, what isn’t, and when something can’t be promised.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section section--ink" aria-labelledby="local-context-heading">
    <div class="container split-feature">
      <div>
        <p class="eyebrow">Built in Falls City</p>
        <h2 class="display" id="local-context-heading">Websites shaped for the way local businesses work.</h2>
      </div>
      <div>
        <p class="lede">A small business website usually has a simple job. It explains the service, gives people a reason to trust you, and makes it easy to get in touch. That takes clear writing and good structure more than complex software.</p>
        <p class="lede">We know the area, and we use current design and development practices on every page we build.</p>
        <a class="text-link" href="/process/">See what working together looks like</a>
      </div>
    </div>
  </section>

  <CallToAction title="Let’s talk about your website." copy="Tell us what you do, who your customers are, and what isn’t working online right now. That’s enough to get started." />
</BaseLayout>
