---
import Logo from '../components/Logo.astro';
import '../styles/tokens.css';
import '../styles/base.css';
---
<!doctype html><html lang="en-US"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex"><meta name="description" content="Page not found. Return to Falls City projects, contact, or the Spanish website."><title>Page not found | Falls City</title><link rel="icon" href="/brand/favicon.svg" type="image/svg+xml"></head><body><main class="not-found"><a href="/" aria-label="Falls City home"><Logo /></a><p class="eyebrow">404 / Página no encontrada</p><h1>This page is not in the portfolio.<span lang="es-US">Esta página no está en el portafolio.</span></h1><p>The address may have changed. <span lang="es-US">Puede que la dirección haya cambiado.</span></p><nav aria-label="Recovery navigation"><a href="/">Home</a><a href="/work/">Work</a><a href="/contact/">Contact</a><a href="/es/" lang="es-US">Español</a></nav></main></body></html>
<style>body{display:grid;min-height:100vh;place-items:center}.not-found{width:min(900px,calc(100% - 32px));padding:3rem 0;display:grid;gap:2rem}.not-found>a>svg{width:180px}.not-found h1{font-size:clamp(3rem,9vw,6.5rem)}.not-found h1 span{display:block;color:var(--cobalt);font-style:italic;margin-top:1rem}.not-found nav{display:flex;gap:1.5rem;flex-wrap:wrap}.not-found nav a{min-height:44px;display:flex;align-items:center}</style>
