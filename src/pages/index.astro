---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroArtwork from '../components/HeroArtwork.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ProcessPreview from '../components/ProcessPreview.astro';
import FaqList from '../components/FaqList.astro';
import CallToAction from '../components/CallToAction.astro';
import { services } from '../data/services';
import { homeFaqs } from '../data/faqs';
import CapabilityArtwork from '../components/CapabilityArtwork.astro';
import PortfolioGrid from '../components/PortfolioGrid.astro';
import LouisvilleSkyline from '../components/LouisvilleSkyline.astro';

---

<BaseLayout
  title="Web Design in Louisville, KY | Falls City Dev Studio"
  description="Custom websites for Louisville small businesses and independent professionals: design and development, SEO foundations, domain, hosting and SSL setup, and ongoing maintenance."
>
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__visual reveal">
        <HeroArtwork />
      </div>
      <div class="hero__content">
        <p class="eyebrow hero__eyebrow reveal">Web design in Louisville, Kentucky</p>
        <h1 class="reveal reveal--delay">A better website for the business <em>you’ve built.</em></h1>
        <p class="hero__copy reveal reveal--delay">We design and build websites for small businesses in Louisville. Each site is made for your business and set up so customers can find you and get in touch.</p>
        <div class="button-row reveal reveal--late">
          <a class="button" href="/contact/">Get a Quote</a>
          <a class="text-link" href="/services/">Explore Services</a>
        </div>
      </div>
    </div>
    <LouisvilleSkyline variant="hero" />
  </section>

  <section class="capabilities" id="capabilities" aria-label="Website project capabilities">
    <div class="container capabilities__grid">
      <article class="capability">
        <CapabilityArtwork variant="business" />
        <div class="capability__body">
          <h2>Made for your business</h2>
          <p>Designed around your services</p>
        </div>
      </article>
      <article class="capability">
        <CapabilityArtwork variant="devices" />
        <div class="capability__body">
          <h2>Works on every screen</h2>
          <p>Built mobile-first and accessible</p>
        </div>
      </article>
      <article class="capability">
        <CapabilityArtwork variant="search" />
        <div class="capability__body">
          <h2>Ready for search</h2>
          <p>Technical SEO from day one</p>
        </div>
      </article>
    </div>
  </section>

  <section class="section section--bright section--work" id="work" aria-labelledby="work-heading">
    <div class="container">
      <SectionHeading
        id="work-heading"
        eyebrow="Selected work"
        title="Real websites, live today."
        copy="Some of the sites we’ve designed and built. Most are for small businesses, one is a documentation site, and a couple are personal projects. Each link opens the live site."
      />
      <PortfolioGrid />
    </div>
  </section>

  <section class="section" aria-labelledby="services-heading">
    <div class="container">
      <SectionHeading
        id="services-heading"
        eyebrow="What we do"
        title="What we can do for your website."
        copy="Most projects use some or all of these four services. We’ll help you work out which ones you need."
      />
      <div class="service-grid">
        {services.map((service) => <ServiceCard service={service} />)}
      </div>
    </div>
  </section>

  <section class="section section--bright" aria-labelledby="why-heading">
    <div class="container split-feature">
      <div class="split-feature__sticky">
        <p class="eyebrow">Why Falls City</p>
        <h2 class="display" id="why-heading">A small studio that only does websites.</h2>
        <p class="lede">You don’t need a large agency or a package of services you’ll never use. You need a website that represents your business well, and someone who explains the work as it happens.</p>
        <a class="text-link" href="/about/">How the studio works</a>
      </div>
      <div class="principle-list">
        <div class="principle reveal-on-scroll">
          <h3>Your message comes first</h3>
          <p>Visitors should be able to tell what you do and how to reach you within a few seconds. The design is there to support that.</p>
        </div>
        <div class="principle reveal-on-scroll">
          <h3>The details are handled</h3>
          <p>Pages adjust to any screen, the code is clean, the site works with a keyboard and screen readers, and it loads quickly.</p>
        </div>
        <div class="principle reveal-on-scroll">
          <h3>Explained in plain English</h3>
          <p>You’ll know what is being built, what we need from you, and how the technical parts fit together.</p>
        </div>
        <div class="principle reveal-on-scroll">
          <h3>Built to last past launch</h3>
          <p>A website should keep working for years and be easy to update when your business changes.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--ink" aria-labelledby="process-heading">
    <div class="container">
      <SectionHeading
        id="process-heading"
        eyebrow="How a project runs"
        title="From the first conversation to launch."
        copy="Every project follows the same five steps. You review the real site as it takes shape and always know what happens next."
      />
      <ProcessPreview />
      <a class="text-link" href="/process/">See the full project process</a>
    </div>
  </section>

  <section class="section section--river" aria-labelledby="local-heading">
    <svg class="local-panel__waves" viewBox="0 0 1200 400" fill="none" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0 80c150-60 250 60 400 0s250-60 400 0 250 60 400 0" stroke="currentColor" stroke-width="1.5" />
      <path d="M0 160c150-60 250 60 400 0s250-60 400 0 250 60 400 0" stroke="currentColor" stroke-width="1.5" />
      <path d="M0 240c150-60 250 60 400 0s250-60 400 0 250 60 400 0" stroke="currentColor" stroke-width="1.5" />
      <path d="M0 320c150-60 250 60 400 0s250-60 400 0 250 60 400 0" stroke="currentColor" stroke-width="1.5" />
    </svg>
    <div class="container local-panel">
      <div>
        <p class="eyebrow">Area code 502</p>
        <h2 class="local-panel__title" id="local-heading">We work in Louisville, <em>for Louisville businesses.</em></h2>
      </div>
      <div class="local-panel__copy">
        <p>A good-looking page isn’t enough for a local business. Your website should help a neighbor understand what you do, trust you, and get in touch without hunting for a phone number.</p>
        <p>We can help whether you need a <a href="/services/web-design/">first website or a redesign</a>, the <a href="/services/seo-foundations/">SEO foundations</a> behind it, or <a href="/services/website-maintenance/">ongoing maintenance</a> after launch.</p>
        <a class="text-link" href="/contact/">Talk about your Louisville business</a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="faq-heading">
    <div class="container faq-layout">
      <div class="faq-layout__intro">
        <p class="eyebrow">Common questions</p>
        <h2 class="display" id="faq-heading">What people usually ask first.</h2>
        <p class="lede">A few things business owners tend to want to know before starting a project.</p>
        <a class="text-link" href="/contact/">Ask your own question</a>
      </div>
      <FaqList faqs={homeFaqs} />
    </div>
  </section>

  <CallToAction />
</BaseLayout>
