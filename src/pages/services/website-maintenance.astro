---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import FaqList from '../../components/FaqList.astro';
import CallToAction from '../../components/CallToAction.astro';
import { services } from '../../data/services';
import { homeFaqs, serviceFaqs } from '../../data/faqs';
import { serviceNode } from '../../lib/seo';

const service = services.find((item) => item.anchor === 'website-maintenance')!;
const path = '/services/website-maintenance/';
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Services', path: '/services/' },
  { name: 'Website Maintenance', path },
];
const structuredData = [
  serviceNode({
    name: service.title,
    serviceType: 'Website maintenance and support',
    description: service.description,
    path,
  }),
];

const faqs = [
  serviceFaqs[2]!,
  homeFaqs[4]!,
  {
    question: 'Can you maintain a website someone else built?',
    answer:
      'Describe the site in your inquiry: what it is built with, where it is hosted, and what needs attention. Whether ongoing maintenance is a good fit depends on the platform and its current condition, and that is discussed before any agreement.',
  },
  serviceFaqs[1]!,
];
---

<BaseLayout
  title="Website Maintenance in Louisville, KY | Falls City Dev Studio"
  description="Ongoing website maintenance for Louisville small businesses: agreed updates, fixes, performance and reliability checks, and basic technical support, with the scope set before work begins."
  pathname={path}
  breadcrumbs={breadcrumbs}
  structuredData={structuredData}
>
  <PageHero
    breadcrumbs={breadcrumbs}
    eyebrow="Website maintenance"
    title="Website maintenance with the scope agreed up front."
    copy="Ongoing technical care for your business website, so updates get made, problems get fixed, and you have a clear place to turn when something needs attention."
  >
    <a class="text-link" href="/contact/">Ask about website maintenance</a>
  </PageHero>

  <section class="section section--bright" aria-labelledby="covers-heading">
    <div class="container">
      <SectionHeading
        id="covers-heading"
        eyebrow="What maintenance can cover"
        title="Routine care, defined in writing."
        copy={service.description}
      />
      <div class="scope-grid">
        <div class="scope-card">
          <h3>Work that can be included</h3>
          <ul class="check-list">{service.details.map((item) => <li>{item}</li>)}</ul>
        </div>
        <div class="scope-card scope-card--muted">
          <h3>Agreed before it starts</h3>
          <p>Before maintenance starts, we agree in writing on which updates and fixes are covered, how you send requests, how extra work gets quoted, and which accounts each of us manages.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="why-heading">
    <div class="container">
      <SectionHeading
        id="why-heading"
        eyebrow="Why it matters"
        title="Websites drift when nobody is looking after them."
        copy="Most problems on small business websites are small ones that go unnoticed and quietly cost you inquiries."
      />
      <div class="service-grid">
        <article class="service-card service-card--plain">
          <h3>Out-of-date business details</h3>
          <p>Old hours, retired services, or a changed phone number send customers the wrong message. Content updates keep what visitors read accurate.</p>
        </article>
        <article class="service-card service-card--plain">
          <h3>Broken forms and links</h3>
          <p>An inquiry form that stops delivering, or a link to a page that no longer exists, can go unnoticed for months. Periodic checks catch these early.</p>
        </article>
        <article class="service-card service-card--plain">
          <h3>Domains and certificates</h3>
          <p>A lapsed domain or an HTTPS problem can take a site offline or put a browser warning in front of customers. Keeping track of renewals and certificates avoids that.</p>
        </article>
        <article class="service-card service-card--plain">
          <h3>Dependencies and platforms</h3>
          <p>The software behind a website changes over time. Keeping it current, where applicable, protects reliability and performance.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section section--ink" aria-labelledby="hosting-heading">
    <div class="container split-feature">
      <div>
        <p class="eyebrow">Hosting and launch support</p>
        <h2 class="display" id="hosting-heading">Maintenance works best when the setup is documented.</h2>
      </div>
      <div>
        <p class="lede">When the studio sets up your domain connection, hosting, deployment, and HTTPS, the services in use are documented, so ongoing care starts from a clear baseline.</p>
        <a class="text-link" href="/services/#domains-hosting-ssl">Domain, hosting, and SSL setup</a>
        <a class="text-link" href="/services/web-design/">Small business website design</a>
      </div>
    </div>
  </section>

  <section class="section section--bright" aria-labelledby="maintenance-faq-heading">
    <div class="container faq-layout">
      <div class="faq-layout__intro">
        <p class="eyebrow">Maintenance questions</p>
        <h2 class="display" id="maintenance-faq-heading">Questions about maintenance.</h2>
        <a class="text-link" href="/contact/">Ask your own question</a>
      </div>
      <FaqList faqs={faqs} />
    </div>
  </section>

  <CallToAction
    title="Need a dependable place to turn for website updates?"
    copy="Tell us about your website, what keeps going wrong, and what you would like handled. We will start by defining a practical scope."
  />
</BaseLayout>
