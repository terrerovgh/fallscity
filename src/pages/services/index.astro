---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import FaqList from '../../components/FaqList.astro';
import CallToAction from '../../components/CallToAction.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { services } from '../../data/services';
import { serviceFaqs } from '../../data/faqs';
import { serviceNode } from '../../lib/seo';

// Domains, hosting & SSL has no page of its own, so its Service entity lives
// here. The other services are described on their dedicated pages.
const hosting = services.find((service) => service.anchor === 'domains-hosting-ssl');
const structuredData = hosting
  ? [
      serviceNode({
        name: hosting.title,
        serviceType: 'Domain, hosting, and SSL setup',
        description: hosting.description,
        path: hosting.href,
      }),
    ]
  : [];
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Services', path: '/services/' },
];
---

<BaseLayout
  title="Website Services for Louisville Businesses | Falls City Dev Studio"
  description="Website design and development, SEO foundations, domain, hosting and SSL setup, and website maintenance for Louisville small businesses. See what each service covers."
  pageType="CollectionPage"
  breadcrumbs={breadcrumbs}
  structuredData={structuredData}
>
  <PageHero
    breadcrumbs={breadcrumbs}
    eyebrow="Services"
    title="The right pieces for a professional business website."
    copy="Clear design, careful development, and the technical support required to launch and maintain your site. Each engagement is scoped around your actual needs."
  >
    <a class="text-link" href="/contact/">Discuss your project</a>
  </PageHero>

  <section class="section--bright" aria-label="Service details">
    <div class="container service-details">
      {services.map((service) => (
        <article class="service-detail reveal-on-scroll" id={service.anchor}>
          <span class="service-detail__number" aria-hidden="true">{service.number}</span>
          <div>
            <div class="service-detail__header">
              <h2>{service.title}</h2>
              <p class="service-detail__description">{service.description}</p>
            </div>
            <div class="service-detail__body">
              <div>
                <h3>What this helps you do</h3>
                <ul class="check-list">{service.outcomes.map((item) => <li>{item}</li>)}</ul>
              </div>
              <div>
                <h3>Work can include</h3>
                <ul class="check-list">{service.details.map((item) => <li>{item}</li>)}</ul>
              </div>
            </div>
            {service.href.startsWith('/services/#') ? null : (
              <a class="text-link" href={service.href}>{service.linkLabel}</a>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section" aria-labelledby="scope-heading">
    <div class="container">
      <SectionHeading
        id="scope-heading"
        eyebrow="A deliberately focused scope"
        title="Web expertise, not an everything agency."
        copy="Staying focused makes the work clearer. Falls City Dev Studio concentrates on the design, development, launch, and care of effective business websites."
      />
      <div class="scope-grid">
        <div class="scope-card">
          <h3>A good fit when you need</h3>
          <ul class="check-list">
            <li>A new website for a small or service-based business</li>
            <li>A more professional replacement for an outdated site</li>
            <li>Clearer services and a better mobile experience</li>
            <li>Technical help with launch and ongoing care</li>
          </ul>
        </div>
        <div class="scope-card scope-card--muted">
          <h3>Not positioned as</h3>
          <ul class="check-list check-list--no">
            <li>A paid advertising or social media management agency</li>
            <li>An enterprise software or complex CRM provider</li>
            <li>A broad digital marketing campaign partner</li>
            <li>A source of guaranteed search rankings</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--bright" aria-labelledby="service-faq-heading">
    <div class="container faq-layout">
      <div class="faq-layout__intro">
        <p class="eyebrow">Service questions</p>
        <h2 class="display" id="service-faq-heading">Know what the work includes.</h2>
      </div>
      <FaqList faqs={serviceFaqs} />
    </div>
  </section>

  <CallToAction title="Let’s define the right scope for your website." copy="Share what your business needs and where your current website falls short. We can start by identifying the work that will be genuinely useful." />
</BaseLayout>
