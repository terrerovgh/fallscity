---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import FaqList from '../../components/FaqList.astro';
import CallToAction from '../../components/CallToAction.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { services } from '../../data/services';
import { serviceFaqs } from '../../data/faqs';
import { serviceNode } from '../../lib/seo';

// Domains, hosting & SSL has no page of its own, so its Service entity lives
// here. The other services are described on their dedicated pages.
const hosting = services.find((service) => service.anchor === 'domains-hosting-ssl');
const structuredData = hosting
  ? [
      serviceNode({
        name: hosting.title,
        serviceType: 'Domain, hosting, and SSL setup',
        description: hosting.description,
        path: hosting.href,
      }),
    ]
  : [];
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Services', path: '/services/' },
];
---

<BaseLayout
  title="Website Services for Louisville Businesses | Falls City Dev Studio"
  description="Website design and development, SEO foundations, domain, hosting and SSL setup, and website maintenance for Louisville small businesses. See what each service covers."
  pageType="CollectionPage"
  breadcrumbs={breadcrumbs}
  structuredData={structuredData}
>
  <PageHero
    breadcrumbs={breadcrumbs}
    eyebrow="Services"
    title="Website services for Louisville businesses."
    copy="Design, development, and the technical setup needed to launch and maintain your site. Each project is scoped around what your business needs."
  >
    <a class="text-link" href="/contact/">Discuss your project</a>
  </PageHero>

  <section class="section--bright" aria-label="Service details">
    <div class="container service-details">
      {services.map((service) => (
        <article class="service-detail reveal-on-scroll" id={service.anchor}>
          <div>
            <div class="service-detail__header">
              <h2>{service.title}</h2>
              <p class="service-detail__description">{service.description}</p>
            </div>
            <div class="service-detail__body">
              <h3>Work can include</h3>
              <ul class="check-list">{service.details.map((item) => <li>{item}</li>)}</ul>
            </div>
            {service.href.startsWith('/services/#') ? null : (
              <a class="text-link" href={service.href}>{service.linkLabel}</a>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section" aria-labelledby="scope-heading">
    <div class="container">
      <SectionHeading
        id="scope-heading"
        eyebrow="What we focus on"
        title="A short list of services, on purpose."
        copy="Falls City Dev Studio works on the design, development, launch, and upkeep of business websites, and nothing outside of that."
      />
      <div class="scope-grid">
        <div class="scope-card">
          <h3>A good fit</h3>
          <p>You run a small or service-based business and need a first website, want to replace an outdated one, or need technical help launching and looking after it.</p>
        </div>
        <div class="scope-card scope-card--muted">
          <h3>Probably not a fit</h3>
          <p>You’re looking for paid advertising, social media management, a CRM or other enterprise software, or a broad marketing campaign. We also don’t promise search rankings, because no one honestly can.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--bright" aria-labelledby="service-faq-heading">
    <div class="container faq-layout">
      <div class="faq-layout__intro">
        <p class="eyebrow">Service questions</p>
        <h2 class="display" id="service-faq-heading">Questions about the services.</h2>
      </div>
      <FaqList faqs={serviceFaqs} />
    </div>
  </section>

  <CallToAction title="Not sure which services you need?" copy="Tell us about your business and where your current website falls short. We’ll help you sort out what’s worth doing." />
</BaseLayout>
