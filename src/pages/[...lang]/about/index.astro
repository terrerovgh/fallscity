---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import ContentSections from '../../../components/ContentSections.astro';
import { aboutPage } from '../../../data/pages';
import type { Lang } from '../../../i18n';
export function getStaticPaths() { return [{ params: { lang: undefined }, props: { lang: 'en' } }, { params: { lang: 'es' }, props: { lang: 'es' } }]; }
const { lang } = Astro.props as { lang: Lang };
const copy = aboutPage[lang];
---
<BaseLayout lang={lang} route="about" title={copy.metadata.title} description={copy.metadata.description}>
  <PageHero lang={lang} route="about" eyebrow={copy.eyebrow} title={copy.h1} intro={copy.intro}>
    <div class="about-hero-art"><span>Louisville</span><span>Kentucky / USA</span><strong>EN<br><i>+</i> ES</strong><p>{lang === 'en' ? 'Remote work, wherever you are in the United States.' : 'Trabajo remoto, esté donde esté en Estados Unidos.'}</p></div>
  </PageHero>
  <section class="about-content wrap"><ContentSections sections={copy.sections} /></section>
</BaseLayout>
