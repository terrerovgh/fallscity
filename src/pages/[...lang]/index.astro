---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResponsiveCapture from '../../components/ResponsiveCapture.astro';
import PublishingDiagram from '../../components/PublishingDiagram.astro';
import Plans from '../../components/Plans.astro';
import ProcessSteps from '../../components/ProcessSteps.astro';
import FaqList from '../../components/FaqList.astro';
import { homeCopy, homeMetadata } from '../../data/home';
import { projects } from '../../data/portfolio';
import { tradeSummaries } from '../../data/trades';
import { homeFaqKeys, pickFaqs } from '../../data/faqs';
import { localizePath, type Lang } from '../../i18n';
import { ui } from '../../data/ui';

export function getStaticPaths() {
  return [{ params: { lang: undefined }, props: { lang: 'en' } }, { params: { lang: 'es' }, props: { lang: 'es' } }];
}
const { lang } = Astro.props as { lang: Lang };
const copy = homeCopy[lang];
---
<BaseLayout lang={lang} route="home" title={homeMetadata[lang].title} description={homeMetadata[lang].description}>
  <section class="home-hero wrap">
    <div class="hero-heading">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1><span>{copy.titleA}</span><em>{copy.titleB}</em></h1>
    </div>
    <div class="hero-intro"><p>{copy.intro}</p><div class="button-row"><a class="button button-dark" href={localizePath(lang, 'contact')}>{ui[lang].cta}<span aria-hidden="true">↗</span></a><a class="text-link" href="#selected-work">{ui[lang].secondaryCta}<span aria-hidden="true">↓</span></a></div></div>
    <a class="hero-artifact" href="https://goodnina.com/" target="_blank" rel="noopener noreferrer" aria-label={lang === 'en' ? 'Open Nina Romero’s public website in a new tab' : 'Abrir la página pública de Nina Romero en una pestaña nueva'}>
      <div class="hero-art-top"><span>{copy.proof}</span><span>{lang === 'en' ? 'Visit live site' : 'Visitar la página'} ↗</span></div>
      <div class="hero-art-frame"><span class="hero-art-number" aria-hidden="true">01</span><ResponsiveCapture base="01-goodnina-home" priority alt={lang === 'en' ? 'Nina Romero website homepage with floral portrait, bilingual navigation, and fine-line tattoo positioning' : 'Portada de Nina Romero con retrato floral, navegación bilingüe y especialización en línea fina'} /></div>
      <div class="hero-art-caption"><span>goodnina.com</span><span>{lang === 'en' ? 'Portfolio / Artist story / Booking link' : 'Portafolio / Historia / Enlace de reservas'}</span></div>
    </a>
  </section>

  <section class="selected-work wrap" id="selected-work">
    <div class="section-heading"><p class="eyebrow">{copy.workEyebrow}</p><h2>{copy.workTitle.split('\n').map((line) => <span>{line}</span>)}</h2><p>{copy.workCopy}</p></div>
    <div class="work-list">
      {projects.slice(0, 3).map((project, index) => <article class:list={['work-item', { reverse: index % 2 === 1 }]}>
        <a class="work-image" href={project.url} target="_blank" rel="noopener noreferrer"><ResponsiveCapture base={index === 0 ? '01-goodnina-gallery' : project.imageBase} alt={`${project.name} — ${project.kind[lang]}`} /><span class="work-open">{lang === 'en' ? 'Open live project' : 'Abrir proyecto'} ↗</span></a>
        <div class="work-info"><span class="work-index">0{index + 1}</span><p class="work-kind">{project.kind[lang]}</p><h3>{project.name}</h3><p>{project.description[lang]}</p><p class="work-evidence">{project.evidence[lang]}</p><a class="domain-link" href={project.url} target="_blank" rel="noopener noreferrer">{project.domain} ↗</a></div>
      </article>)}
    </div>
    <a class="text-link work-all" href={localizePath(lang, 'work')}>{copy.allWork}<span aria-hidden="true">↗</span></a>
  </section>

  <section class="product-story">
    <div class="wrap product-story-inner"><div class="section-heading"><p class="eyebrow">{copy.productEyebrow}</p><h2>{copy.productTitle}</h2><p>{copy.productCopy}</p><a class="text-link" href={localizePath(lang, 'panel')}>{lang === 'en' ? 'See what you can update' : 'Conozca qué puede actualizar'} ↗</a></div><PublishingDiagram lang={lang} /></div>
  </section>

  <section class="control-section wrap">
    <div class="section-heading"><p class="eyebrow">{copy.controlEyebrow}</p><h2>{copy.controlTitle}</h2></div>
    <div class="control-grid"><div><h3>{copy.youTitle}</h3><ul>{copy.youItems.map((item) => <li>{item}</li>)}</ul></div><div><h3>{copy.usTitle}</h3><ul>{copy.usItems.map((item) => <li>{item}</li>)}</ul></div></div>
    <p class="ownership-note"><span aria-hidden="true">FC</span>{copy.ownership}</p>
  </section>

  <section class="pricing-section" id="pricing"><div class="wrap"><div class="section-heading split-heading"><div><p class="eyebrow">{copy.pricingEyebrow}</p><h2>{copy.pricingTitle}</h2></div><p>{copy.pricingCopy}</p></div><Plans lang={lang} /><a class="text-link" href={localizePath(lang, 'pricing')}>{lang === 'en' ? 'Compare plans, care, and extras' : 'Comparar planes, cuidado y extras'} ↗</a></div></section>

  <section class="process-section wrap"><div class="section-heading split-heading"><div><p class="eyebrow">{copy.processEyebrow}</p><h2>{copy.processTitle}</h2></div><a class="text-link" href={localizePath(lang, 'process')}>{copy.processLink} ↗</a></div><ProcessSteps lang={lang} /></section>

  <section class="trades-section"><div class="wrap trades-grid"><div><p class="eyebrow">{copy.tradesEyebrow}</p><h2>{copy.tradesTitle}</h2><p>{copy.tradesCopy}</p></div><div class="trade-links">{tradeSummaries[lang].map((trade, index) => <a href={localizePath(lang, trade.id)}><span>0{index + 4}</span><strong>{trade.name}</strong><p>{trade.summary}</p><span aria-hidden="true">↗</span></a>)}</div></div></section>

  <section class="faq-section wrap"><div class="section-heading"><p class="eyebrow">{copy.faqEyebrow}</p><h2>{copy.faqTitle}</h2></div><FaqList items={pickFaqs(lang, homeFaqKeys)} /></section>
</BaseLayout>
