---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import SectionHeading from '../../../components/SectionHeading.astro';
import FaqList from '../../../components/FaqList.astro';
import CallToAction from '../../../components/CallToAction.astro';
import { getService } from '../../../data/services';
import { pickFaqs } from '../../../data/faqs';
import { serviceNode } from '../../../lib/seo';
import { langPaths, localizePath, type Lang } from '../../../i18n';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const lp = (path: string) => localizePath(path, lang);

const copy = {
  en: {
    title: 'Small Business SEO Foundations in Louisville | Falls City Dev Studio',
    description:
      'The technical and on-page SEO groundwork built into every website: titles, headings, canonical URLs, sitemaps, structured data, and indexing readiness. Clearly scoped, with no ranking guarantees.',
    crumbs: ['Home', 'Services', 'SEO Foundations'],
    schemaName: 'SEO Foundations for Small Business Websites',
    schemaType: 'Technical and on-page SEO setup',
    eyebrow: 'SEO foundations',
    heroTitle: 'The technical groundwork search engines need.',
    heroCopy: 'Search visibility starts with a website that is useful, understandable, and technically sound. These foundations are built into the project from the start.',
    heroLink: 'Discuss your website',
    includedEyebrow: 'What is included',
    includedTitle: 'What we set up on every site.',
    includedCopy: 'These are the pieces that help search engines discover your pages and understand what your business offers.',
    foundations: [
      { title: 'Pages that match what people search for', copy: 'Each important service gets a clear page with a descriptive heading and plain-language content, so the words customers use appear where they expect them.' },
      { title: 'Unique titles and descriptions', copy: 'Every indexable page gets its own title and meta description, written for the person deciding whether to click instead of stuffed with keywords.' },
      { title: 'Semantic HTML and logical headings', copy: 'One main heading per page and a sensible outline beneath it help both search engines and assistive technology understand the content.' },
      { title: 'Canonical URLs, XML sitemap, and robots.txt', copy: 'One preferred address per page, a sitemap that lists only real, indexable pages, and crawler rules that do not block what should be found.' },
      { title: 'Structured data from verified facts', copy: 'Schema markup describes your business using only information you have confirmed. We never add addresses, hours, ratings, or reviews that aren’t real.' },
      { title: 'Crawlable links and fast, mobile-first pages', copy: 'Descriptive internal links, content present in the HTML rather than hidden behind scripts, and pages built to load quickly on phones.' },
    ],
    scopeEyebrow: 'Scope',
    scopeTitle: 'What this service doesn’t cover.',
    scopeCopy: 'SEO foundations get your website ready to be found, but nobody can guarantee where it will rank. Ongoing blog content, link building, and paid search are separate work and aren’t part of this service.',
    localEyebrow: 'Local search in Louisville',
    localTitle: 'Your website is one part of local visibility.',
    localCopy1: 'Google describes local results as depending mainly on relevance, distance, and prominence. A clear website helps with relevance: it states what you do and where you serve.',
    localCopy2: 'Map listings are a separate system. They rely on a Google Business Profile, which has its own eligibility rules and should be owned and managed by your business.',
    localLink: 'How websites are planned and built',
    faqEyebrow: 'SEO questions',
    faqTitle: 'Questions about search.',
    faqLink: 'Ask your own question',
    ctaTitle: 'Start with a website that is ready to be found.',
    ctaCopy: 'Tell us about your business and your current site, and we’ll explain what the foundations would involve for your project.',
  },
  es: {
    title: 'Bases de SEO para Negocios en Louisville | Falls City Dev Studio',
    description:
      'El trabajo de SEO técnico y de contenido incluido en cada página: títulos, encabezados, URLs canónicas, mapa del sitio, datos estructurados y preparación para indexar. Alcance claro, sin garantías de posición.',
    crumbs: ['Inicio', 'Servicios', 'Bases de SEO'],
    schemaName: 'Bases de SEO para páginas web de pequeños negocios',
    schemaType: 'Configuración de SEO técnico y de contenido',
    eyebrow: 'Bases de SEO',
    heroTitle: 'La base técnica que necesitan los buscadores.',
    heroCopy: 'La visibilidad en los buscadores empieza con una página útil, fácil de entender y técnicamente bien hecha. Estas bases forman parte del proyecto desde el principio.',
    heroLink: 'Hablemos de su página',
    includedEyebrow: 'Qué incluye',
    includedTitle: 'Lo que configuramos en cada sitio.',
    includedCopy: 'Estas son las piezas que ayudan a los buscadores a encontrar sus páginas y entender lo que ofrece su negocio.',
    foundations: [
      { title: 'Páginas que responden a lo que la gente busca', copy: 'Cada servicio importante tiene una página clara, con un encabezado descriptivo y textos sencillos, para que las palabras que usan sus clientes aparezcan donde las esperan.' },
      { title: 'Títulos y descripciones únicos', copy: 'Cada página indexable tiene su propio título y meta descripción, escritos para la persona que decide si hacer clic, no llenos de palabras clave.' },
      { title: 'HTML semántico y encabezados ordenados', copy: 'Un encabezado principal por página y una estructura lógica debajo ayudan a los buscadores y a las tecnologías de asistencia a entender el contenido.' },
      { title: 'URLs canónicas, mapa del sitio XML y robots.txt', copy: 'Una dirección preferida por página, un mapa del sitio que solo incluye páginas reales e indexables, y reglas para rastreadores que no bloquean lo que debe encontrarse.' },
      { title: 'Datos estructurados con información verificada', copy: 'El marcado de schema describe su negocio solo con información que usted confirmó. Nunca agregamos direcciones, horarios, calificaciones ni reseñas que no sean reales.' },
      { title: 'Enlaces rastreables y páginas rápidas para el teléfono', copy: 'Enlaces internos descriptivos, contenido presente en el HTML en lugar de escondido detrás de scripts, y páginas hechas para cargar rápido en el teléfono.' },
    ],
    scopeEyebrow: 'Alcance',
    scopeTitle: 'Lo que este servicio no cubre.',
    scopeCopy: 'Las bases de SEO preparan su página para que la encuentren, pero nadie puede garantizar en qué lugar va a aparecer. El contenido continuo de blog, la obtención de enlaces y los anuncios pagados son trabajos aparte y no forman parte de este servicio.',
    localEyebrow: 'Búsqueda local en Louisville',
    localTitle: 'Su página web es una parte de la visibilidad local.',
    localCopy1: 'Google explica que los resultados locales dependen sobre todo de la relevancia, la distancia y la prominencia. Una página clara ayuda con la relevancia: dice qué hace usted y dónde atiende.',
    localCopy2: 'Los resultados del mapa son un sistema aparte. Dependen de un Perfil de Empresa en Google, que tiene sus propias reglas y debe pertenecer a su negocio y ser administrado por él.',
    localLink: 'Cómo se planean y construyen las páginas',
    faqEyebrow: 'Preguntas sobre SEO',
    faqTitle: 'Preguntas sobre los buscadores.',
    faqLink: 'Haga su propia pregunta',
    ctaTitle: 'Empiece con una página lista para que la encuentren.',
    ctaCopy: 'Cuéntenos de su negocio y de su página actual, y le explicamos qué implicarían las bases de SEO en su proyecto.',
  },
}[lang];

const service = getService(lang, 'seo-foundations');
const path = lp('/services/seo-foundations/');
const breadcrumbs = [
  { name: copy.crumbs[0]!, path: lp('/') },
  { name: copy.crumbs[1]!, path: lp('/services/') },
  { name: copy.crumbs[2]!, path },
];
const structuredData = [
  serviceNode({ name: copy.schemaName, serviceType: copy.schemaType, description: service.description, path }),
];
const faqs = pickFaqs(lang, ['rankings', 'ongoingSeo']);
---

<BaseLayout title={copy.title} description={copy.description} pathname={path} breadcrumbs={breadcrumbs} structuredData={structuredData}>
  <PageHero breadcrumbs={breadcrumbs} eyebrow={copy.eyebrow} title={copy.heroTitle} copy={copy.heroCopy}>
    <a class="text-link" href={lp('/contact/')}>{copy.heroLink}</a>
  </PageHero>

  <section class="section section--bright" aria-labelledby="foundations-heading">
    <div class="container">
      <SectionHeading id="foundations-heading" eyebrow={copy.includedEyebrow} title={copy.includedTitle} copy={copy.includedCopy} />
      <div class="service-grid">
        {copy.foundations.map((item) => (
          <article class="service-card service-card--plain">
            <h3>{item.title}</h3>
            <p>{item.copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="scope-heading">
    <div class="container">
      <SectionHeading id="scope-heading" eyebrow={copy.scopeEyebrow} title={copy.scopeTitle} copy={copy.scopeCopy} />
    </div>
  </section>

  <section class="section section--ink" aria-labelledby="local-heading">
    <div class="container split-feature">
      <div>
        <p class="eyebrow">{copy.localEyebrow}</p>
        <h2 class="display" id="local-heading">{copy.localTitle}</h2>
      </div>
      <div>
        <p class="lede">{copy.localCopy1}</p>
        <p class="lede">{copy.localCopy2}</p>
        <a class="text-link" href={lp('/services/web-design/')}>{copy.localLink}</a>
      </div>
    </div>
  </section>

  <section class="section section--bright" aria-labelledby="seo-faq-heading">
    <div class="container faq-layout">
      <div class="faq-layout__intro">
        <p class="eyebrow">{copy.faqEyebrow}</p>
        <h2 class="display" id="seo-faq-heading">{copy.faqTitle}</h2>
        <a class="text-link" href={lp('/contact/')}>{copy.faqLink}</a>
      </div>
      <FaqList faqs={faqs} />
    </div>
  </section>

  <CallToAction title={copy.ctaTitle} copy={copy.ctaCopy} />
</BaseLayout>
