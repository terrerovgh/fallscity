---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import SectionHeading from '../../../components/SectionHeading.astro';
import FaqList from '../../../components/FaqList.astro';
import CallToAction from '../../../components/CallToAction.astro';
import { getService } from '../../../data/services';
import { pickFaqs } from '../../../data/faqs';
import { serviceNode } from '../../../lib/seo';
import { langPaths, localizePath, type Lang } from '../../../i18n';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const lp = (path: string) => localizePath(path, lang);

const copy = {
  en: {
    title: 'Small Business Website Design in Louisville | Falls City Dev Studio',
    description:
      'Custom websites and redesigns for Louisville small businesses: planned around your services, built mobile-first and accessible, and launched with SEO foundations in place.',
    crumbs: ['Home', 'Services', 'Website Design & Development'],
    schemaName: 'Small Business Website Design & Development',
    schemaType: 'Website design and development',
    eyebrow: 'Website design & development',
    heroTitle: 'Small business websites, designed and built in Louisville.',
    heroCopy:
      'A new website or a redesign of the one you have, shaped around what your customers need to know and the action you want them to take. Built in Louisville, for businesses here and across Kentucky.',
    heroLink: 'Request a website quote',
    includedEyebrow: 'What a project includes',
    includedTitle: 'Design, development, and launch in one project.',
    includedCopy: 'Every project is scoped on its own, but the core work is the same. We plan the structure, design the pages, and build a site that holds up.',
    planningTitle: 'Planning and design',
    planningCopy:
      'We plan the pages around your real services and customers and design layouts that fit your business. The next step for a visitor, whether that’s calling, booking, or sending an inquiry, is always easy to find. Text is easy to read, and the navigation works for everyone.',
    devTitle: 'Development and launch',
    devList: [
      'Built mobile-first for every screen size',
      'Fast loading on phones and slower connections',
      'Contact forms and links tested before launch',
      'SEO foundations included from the start',
      'Domain, hosting, and HTTPS setup when it’s in scope',
    ],
    startEyebrow: 'Where you are starting from',
    startTitle: 'A first website, or a better version of the one you have.',
    starts: [
      { title: 'Your first business website', copy: 'You do not need a technical brief. Bring what you know about your business: the services you offer, the questions customers ask, the area you serve, and any logo, photos, or brand materials you already have.' },
      { title: 'Replacing an outdated site', copy: 'A redesign starts with what exists. The current pages, content, and addresses are reviewed so that useful material is kept, weak pages are improved or combined, and links people and search engines already know are carried forward or redirected.' },
      { title: 'A site that is hard to use on phones', copy: 'Layouts, navigation, and contact paths are designed for small screens first, then adapted for larger ones, so a customer on a phone can find what they need and get in touch.' },
      { title: 'A site that doesn’t explain what you do', copy: 'If visitors leave unsure what you do or how to hire you, the fix is usually better structure and wording. Clear service pages and next steps come first.' },
    ],
    howEyebrow: 'How it works',
    howTitle: 'How a website project goes.',
    howCopy1:
      'We start with a conversation and a written scope. Then we design and build, and you review the working site. Before launch we check the domain, HTTPS, page metadata, and the main paths visitors take through the site.',
    howCopy2: 'We also write down which accounts and services the site depends on, so you know what’s running and who manages it.',
    howLink: 'See the full website design process',
    relatedEyebrow: 'Related services',
    relatedTitle: 'What usually goes with a new website.',
    related: [
      { title: 'SEO foundations', copy: 'The technical and on-page groundwork that helps search engines discover and understand your pages.', href: '/services/seo-foundations/', link: 'What SEO foundations include' },
      { title: 'Domains, hosting & SSL', copy: 'Connecting your domain, setting up hosting and deployment, and serving the site securely over HTTPS.', href: '/services/#domains-hosting-ssl', link: 'Domain and hosting setup' },
      { title: 'Website maintenance', copy: 'Agreed updates, fixes, and technical care after launch, so the site does not drift out of date.', href: '/services/website-maintenance/', link: 'Website maintenance in Louisville' },
      { title: 'Selected work', copy: 'Live websites designed and built by the studio, each with a link to the real site.', href: '/#work', link: 'See websites we have built' },
    ],
    faqEyebrow: 'Questions before you start',
    faqTitle: 'What business owners ask about a new website.',
    faqLink: 'Ask about your project',
    ctaTitle: 'Tell us about the website your business needs.',
    ctaCopy: 'Share what you do, who you serve in and around Louisville, and whether you have a site today. That’s enough for a first conversation.',
  },
  es: {
    title: 'Diseño de Páginas Web para Negocios en Louisville | Falls City Dev Studio',
    description:
      'Páginas web a la medida y rediseños para pequeños negocios de Louisville: planeadas según sus servicios, pensadas para el teléfono, accesibles y publicadas con las bases de SEO listas.',
    crumbs: ['Inicio', 'Servicios', 'Diseño y desarrollo web'],
    schemaName: 'Diseño y desarrollo de páginas web para pequeños negocios',
    schemaType: 'Diseño y desarrollo web',
    eyebrow: 'Diseño y desarrollo web',
    heroTitle: 'Páginas web para pequeños negocios, diseñadas y construidas en Louisville.',
    heroCopy:
      'Una página nueva o el rediseño de la que ya tiene, pensada en lo que sus clientes necesitan saber y en lo que usted quiere que hagan. Hecha en Louisville, para negocios de aquí y de todo Kentucky.',
    heroLink: 'Pida una cotización',
    includedEyebrow: 'Qué incluye un proyecto',
    includedTitle: 'Diseño, desarrollo y publicación en un solo proyecto.',
    includedCopy: 'Cada proyecto se define por separado, pero el trabajo principal es el mismo: planeamos la estructura, diseñamos las páginas y construimos un sitio sólido.',
    planningTitle: 'Planeación y diseño',
    planningCopy:
      'Planeamos las páginas según sus servicios y clientes reales, y diseñamos pensando en su negocio. El siguiente paso del visitante, ya sea llamar, reservar o enviar una consulta, siempre es fácil de encontrar. Los textos se leen con facilidad y la navegación funciona para todos.',
    devTitle: 'Desarrollo y publicación',
    devList: [
      'Pensada primero para el teléfono, para cualquier pantalla',
      'Carga rápida en teléfonos y conexiones lentas',
      'Formularios y enlaces probados antes de publicar',
      'Bases de SEO incluidas desde el principio',
      'Dominio, hosting y HTTPS cuando forman parte del alcance',
    ],
    startEyebrow: 'Desde dónde empieza',
    startTitle: 'Su primera página web, o una mejor versión de la que tiene.',
    starts: [
      { title: 'Su primera página de negocio', copy: 'No necesita un documento técnico. Traiga lo que sabe de su negocio: los servicios que ofrece, las preguntas de sus clientes, la zona que atiende y el logo, las fotos o el material de marca que ya tenga.' },
      { title: 'Reemplazar una página anticuada', copy: 'Un rediseño empieza por lo que ya existe. Se revisan las páginas, el contenido y las direcciones actuales para conservar lo útil, mejorar o unir las páginas débiles, y mantener o redirigir los enlaces que la gente y los buscadores ya conocen.' },
      { title: 'Una página difícil de usar en el teléfono', copy: 'El diseño, la navegación y las formas de contacto se hacen primero para pantallas pequeñas y luego se adaptan a las grandes, para que un cliente en el teléfono encuentre lo que busca y le contacte.' },
      { title: 'Una página que no explica qué hace', copy: 'Si los visitantes se van sin entender qué hace usted o cómo contratarle, la solución suele ser una mejor estructura y mejores textos. Primero van las páginas de servicios claras y los siguientes pasos.' },
    ],
    howEyebrow: 'Cómo funciona',
    howTitle: 'Cómo avanza un proyecto web.',
    howCopy1:
      'Empezamos con una conversación y un alcance por escrito. Luego diseñamos y construimos, y usted revisa la página funcionando. Antes de publicar revisamos el dominio, el HTTPS, los metadatos de las páginas y los recorridos principales de los visitantes.',
    howCopy2: 'También dejamos por escrito de qué cuentas y servicios depende la página, para que sepa qué está funcionando y quién lo administra.',
    howLink: 'Ver el proceso completo de diseño web',
    relatedEyebrow: 'Servicios relacionados',
    relatedTitle: 'Lo que suele acompañar a una página nueva.',
    related: [
      { title: 'Bases de SEO', copy: 'El trabajo técnico y de contenido que ayuda a los buscadores a encontrar y entender sus páginas.', href: '/services/seo-foundations/', link: 'Qué incluyen las bases de SEO' },
      { title: 'Dominio, hosting y SSL', copy: 'Conectar su dominio, configurar el hosting y la publicación, y servir el sitio de forma segura con HTTPS.', href: '/services/#domains-hosting-ssl', link: 'Configuración de dominio y hosting' },
      { title: 'Mantenimiento web', copy: 'Actualizaciones, arreglos y cuidado técnico acordados después de publicar, para que la página no se quede atrás.', href: '/services/website-maintenance/', link: 'Mantenimiento web en Louisville' },
      { title: 'Trabajos', copy: 'Páginas en línea diseñadas y construidas por el estudio, cada una con un enlace a la página real.', href: '/#work', link: 'Vea páginas que hemos hecho' },
    ],
    faqEyebrow: 'Preguntas antes de empezar',
    faqTitle: 'Lo que preguntan los dueños de negocios sobre una página nueva.',
    faqLink: 'Pregunte por su proyecto',
    ctaTitle: 'Cuéntenos qué página web necesita su negocio.',
    ctaCopy: 'Díganos qué hace, a quién atiende en Louisville y sus alrededores, y si ya tiene una página. Con eso basta para una primera conversación.',
  },
}[lang];

const service = getService(lang, 'website-design-development');
const path = lp('/services/web-design/');
const breadcrumbs = [
  { name: copy.crumbs[0]!, path: lp('/') },
  { name: copy.crumbs[1]!, path: lp('/services/') },
  { name: copy.crumbs[2]!, path },
];
const structuredData = [
  serviceNode({ name: copy.schemaName, serviceType: copy.schemaType, description: service.description, path }),
];
const faqs = pickFaqs(lang, ['custom', 'cost', 'phones', 'redesign']);
---

<BaseLayout title={copy.title} description={copy.description} pathname={path} breadcrumbs={breadcrumbs} structuredData={structuredData}>
  <PageHero breadcrumbs={breadcrumbs} eyebrow={copy.eyebrow} title={copy.heroTitle} copy={copy.heroCopy}>
    <a class="text-link" href={lp('/contact/')}>{copy.heroLink}</a>
  </PageHero>

  <section class="section section--bright" aria-labelledby="included-heading">
    <div class="container">
      <SectionHeading id="included-heading" eyebrow={copy.includedEyebrow} title={copy.includedTitle} copy={copy.includedCopy} />
      <div class="scope-grid">
        <div class="scope-card">
          <h3>{copy.planningTitle}</h3>
          <p>{copy.planningCopy}</p>
        </div>
        <div class="scope-card">
          <h3>{copy.devTitle}</h3>
          <ul class="check-list">{copy.devList.map((item) => <li>{item}</li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="new-or-redesign-heading">
    <div class="container">
      <SectionHeading id="new-or-redesign-heading" eyebrow={copy.startEyebrow} title={copy.startTitle} />
      <div class="service-grid">
        {copy.starts.map((item) => (
          <article class="service-card service-card--plain">
            <h3>{item.title}</h3>
            <p>{item.copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--ink" aria-labelledby="how-heading">
    <div class="container split-feature">
      <div>
        <p class="eyebrow">{copy.howEyebrow}</p>
        <h2 class="display" id="how-heading">{copy.howTitle}</h2>
      </div>
      <div>
        <p class="lede">{copy.howCopy1}</p>
        <p class="lede">{copy.howCopy2}</p>
        <a class="text-link" href={lp('/process/')}>{copy.howLink}</a>
      </div>
    </div>
  </section>

  <section class="section section--bright" aria-labelledby="related-heading">
    <div class="container">
      <SectionHeading id="related-heading" eyebrow={copy.relatedEyebrow} title={copy.relatedTitle} />
      <div class="service-grid">
        {copy.related.map((item) => (
          <article class="service-card service-card--plain">
            <h3>{item.title}</h3>
            <p>{item.copy}</p>
            <a class="text-link" href={lp(item.href)}>{item.link}</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="design-faq-heading">
    <div class="container faq-layout">
      <div class="faq-layout__intro">
        <p class="eyebrow">{copy.faqEyebrow}</p>
        <h2 class="display" id="design-faq-heading">{copy.faqTitle}</h2>
        <a class="text-link" href={lp('/contact/')}>{copy.faqLink}</a>
      </div>
      <FaqList faqs={faqs} />
    </div>
  </section>

  <CallToAction title={copy.ctaTitle} copy={copy.ctaCopy} />
</BaseLayout>
