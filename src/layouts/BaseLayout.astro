---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/public-sans';
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import type { Crumb, PageType } from '../lib/seo';
import { alternatesFor, langFromPath, langTag, ui } from '../i18n';
import { site } from '../config/site';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  pathname?: string;
  pageType?: PageType;
  breadcrumbs?: Crumb[];
  structuredData?: Record<string, unknown>[];
}

const {
  title,
  description,
  noindex = false,
  pathname,
  pageType,
  breadcrumbs,
  structuredData = [],
} = Astro.props;

// The language comes from the URL (/es/... is Spanish). Every indexable page
// exists in both languages, so each one declares both as hreflang alternates.
const lang = langFromPath(Astro.url.pathname);
const alternates = noindex ? [] : alternatesFor(pathname ?? Astro.url.pathname);
---

<!doctype html>
<html lang={langTag[lang]}>
  <head>
    {import.meta.env.PROD && (
      <Fragment>
        <script is:inline async src={`https://www.googletagmanager.com/gtm.js?id=${site.googleTagId}`}></script>
        <script is:inline>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
        </script>
      </Fragment>
    )}
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <SEO
      title={title}
      description={description}
      noindex={noindex}
      pathname={pathname}
      pageType={pageType}
      breadcrumbs={breadcrumbs}
      structuredData={structuredData}
      lang={langTag[lang]}
      imageAlt={ui[lang].socialImageAlt}
      alternates={alternates}
    />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{ui[lang].skipLink}</a>
    <SiteHeader />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
