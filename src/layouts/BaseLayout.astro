---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { business } from '../config/business';
import { htmlLang, localizePath, type Lang, type RouteKey } from '../i18n';
import { routeLabels, ui } from '../data/ui';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/components.css';
import '../styles/motion.css';

interface Props {
  lang: Lang;
  route: RouteKey;
  title: string;
  description: string;
  noindex?: boolean;
}
const { lang, route, title, description, noindex = false } = Astro.props;
const canonical = `${business.url}${localizePath(lang, route)}`;
const social = `${business.url}/brand/social-${lang}.png`;
const homeSchema = route === 'home' ? [
  { '@type': 'Organization', '@id': `${business.url}/#organization`, name: business.legalName, url: business.url, email: business.email, areaServed: business.areaServed },
  { '@type': 'WebSite', '@id': `${business.url}/#website`, url: business.url, name: business.legalName, publisher: { '@id': `${business.url}/#organization` }, inLanguage: ['en-US', 'es-US'] },
] : [];
const schema = route !== 'home' ? { '@type': 'WebPage', name: title, description, url: canonical, inLanguage: htmlLang(lang), isPartOf: { '@id': `${business.url}/#website` }, breadcrumb: { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: routeLabels[lang].home, item: `${business.url}${localizePath(lang, 'home')}` }, { '@type': 'ListItem', position: 2, name: routeLabels[lang][route], item: canonical }] } } : undefined;
---
<!doctype html>
<html lang={htmlLang(lang)}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex,nofollow" />}
  {!noindex && <><link rel="alternate" hreflang="en-US" href={`${business.url}${localizePath('en', route)}`} /><link rel="alternate" hreflang="es-US" href={`${business.url}${localizePath('es', route)}`} /><link rel="alternate" hreflang="x-default" href={`${business.url}${localizePath('en', route)}`} /></>}
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={social} />
  <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'es_US'} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" href="/brand/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/brand/favicon-32.png" sizes="32x32" />
  <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
  <link rel="preload" href="/fonts/hanken-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/instrument-serif-latin.woff2" as="font" type="font/woff2" crossorigin />
  {route === 'home' && <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': homeSchema })} />}
  {schema && <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', ...schema })} />}
</head>
<body>
  <a class="skip-link" href="#main">{ui[lang].skip}</a>
  <Header lang={lang} route={route} />
  <main id="main"><slot /></main>
  <Footer lang={lang} />
</body>
</html>
