---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/redesign.css';
import '../styles/story-layout.css';
import { faqs, services, studio, tools, ui, type Lang } from '../data/site';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Path of this page in each language, used for canonical and hreflang. */
  paths: Record<Lang, string>;
  noindex?: boolean;
  /** Home page: adds the business, its services and the FAQ to the structured data. */
  home?: boolean;
}

const { lang, title, description, paths, noindex = false, home = false } = Astro.props;
const canonical = new URL(paths[lang], studio.url).href;
const ogImage = new URL('/og.jpg', studio.url).href;

const inLanguage = lang === 'en' ? 'en-US' : 'es-US';
const orgId = `${studio.url}/#studio`;
const business = {
  '@type': 'ProfessionalService',
  '@id': orgId,
  name: studio.name,
  url: studio.url,
  email: studio.email,
  logo: new URL('/favicon.svg', studio.url).href,
  image: ogImage,
  description: ui.meta.description[lang],
  address: { '@type': 'PostalAddress', addressLocality: studio.locality, addressRegion: studio.region, addressCountry: 'US' },
  areaServed: { '@type': 'Country', name: 'United States' },
  knowsLanguage: ['en', 'es'],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: ui.services.title[lang],
    itemListElement: [...services, ...tools].map((s) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: s.title[lang], description: s.body[lang], provider: { '@id': orgId } },
    })),
  },
};
const graph: Record<string, unknown>[] = [
  { '@type': 'WebSite', '@id': `${studio.url}/#website`, url: `${studio.url}/`, name: studio.name, inLanguage: ['en-US', 'es-US'], publisher: { '@id': orgId } },
  { '@type': 'WebPage', '@id': `${canonical}#webpage`, url: canonical, name: title, description, inLanguage, isPartOf: { '@id': `${studio.url}/#website` }, about: { '@id': orgId } },
  business,
];
if (home) {
  graph.push({
    '@type': 'FAQPage',
    '@id': `${canonical}#faq`,
    inLanguage,
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q[lang], acceptedAnswer: { '@type': 'Answer', text: f.a[lang] } })),
  });
}
const jsonLd = { '@context': 'https://schema.org', '@graph': graph };
---

<!doctype html>
<html lang={lang === 'en' ? 'en-US' : 'es-US'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#f7f8fc" />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const scheme = document.querySelector('meta[name="color-scheme"]');
        const bar = document.querySelector('meta[name="theme-color"]');
        const paper = bar.content;
        let timer;

        function updateTheme() {
          const now = new Date();
          const hour = now.getHours();
          const theme = hour >= 7 && hour < 19 ? 'light' : 'dark';
          if (root.dataset.theme !== theme) {
            root.dataset.theme = theme;
            scheme.content = theme;
            bar.content = theme === 'dark' ? '#111726' : paper;
          }

          // Align to the local minute and keep checking if the device clock changes.
          clearTimeout(timer);
          timer = setTimeout(updateTheme, 60_000 - now.getSeconds() * 1_000 - now.getMilliseconds());
        }

        updateTheme();
        document.addEventListener('visibilitychange', () => {
          if (!document.hidden) updateTheme();
        });
        window.addEventListener('pageshow', updateTheme);
        window.addEventListener('focus', updateTheme);
      })();
    </script>
    <script is:inline define:vars={{ gtm: studio.googleTagId }}>
      // Google Tag Manager, only on the production host (not previews or localhost).
      if (location.hostname === 'fallscity.dev') {
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ 'gtm.start': Date.now(), event: 'gtm.js' });
        const s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtm.js?id=' + gtm;
        document.head.append(s);
      }
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {home && <meta name="msvalidate.01" content={studio.bingSiteVerification} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en-US" href={new URL(paths.en, studio.url).href} />
    <link rel="alternate" hreflang="es-US" href={new URL(paths.es, studio.url).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(paths.en, studio.url).href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/instrument-sans-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={studio.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ui.meta.ogAlt[lang]} />
    <meta property="og:locale:alternate" content={lang === 'en' ? 'es_US' : 'en_US'} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'es_US'} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${studio.googleTagId}`} height="0" width="0" style="display:none;visibility:hidden" title="Google Tag Manager"></iframe></noscript>
    <a class="skip" href="#main">{ui.skip[lang]}</a>
    <slot />
  </body>
</html>
