---
import { site } from '../config/site';
import LouisvilleSkyline from './LouisvilleSkyline.astro';

const pathname = Astro.url.pathname;
const isActive = (href: string) => pathname === href || (href !== '/' && pathname.startsWith(href));
---

<header class="site-header">
  <LouisvilleSkyline variant="nav" />
  <div class="container site-header__inner">
    <a class="brand" href="/" aria-label="Falls City Dev Studio, home">
      <img class="brand__logo" src="/brand/fallscity-logo.svg" alt="" width="1259" height="316" fetchpriority="high" />
    </a>

    <nav class="site-nav" aria-label="Main navigation" data-site-nav>
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="navigation-links" aria-label="Open navigation" data-nav-toggle>
        <span class="nav-toggle__icon" aria-hidden="true"></span>
      </button>
      <div class="site-nav__links" id="navigation-links">
        {site.navigation.map((item) => (
          <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
        ))}
        <a class="button" href="/contact/">Get a Website Quote</a>
      </div>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const compact = window.matchMedia('(max-width: 800px)');

  if (header) {
    let range = 0;
    let frame = 0;

    const update = () => {
      frame = 0;
      const progress = compact.matches ? Math.min(1, Math.max(0, window.scrollY / range)) : 0;
      header.style.setProperty('--p', progress.toFixed(4));
      header.toggleAttribute('data-collapsed', progress >= 0.98);
      header.toggleAttribute('data-scrolled', window.scrollY > 8);
    };

    const measure = () => {
      if (!compact.matches) {
        range = 1;
        header.style.removeProperty('--p');
        header.removeAttribute('data-collapsed');
        header.removeAttribute('data-scrolled');
        return;
      }
      range = Math.max(1, parseFloat(getComputedStyle(header).getPropertyValue('--nav-scroll-range')) || 96);
      update();
    };

    window.addEventListener('scroll', () => {
      if (compact.matches && !frame) frame = requestAnimationFrame(update);
    }, { passive: true });
    window.addEventListener('resize', measure);
    compact.addEventListener('change', measure);
    document.fonts.ready.then(measure);
    measure();
  }

  const nav = document.querySelector<HTMLElement>('[data-site-nav]');
  const toggle = nav?.querySelector<HTMLButtonElement>('[data-nav-toggle]');

  if (nav && toggle) {
    const setOpen = (open: boolean) => {
      nav.dataset.open = String(open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
    };

    toggle.addEventListener('click', () => setOpen(nav.dataset.open !== 'true'));
    nav.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setOpen(false)));

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && nav.dataset.open === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });

    document.addEventListener('click', (event) => {
      if (nav.dataset.open === 'true' && !nav.contains(event.target as Node)) setOpen(false);
    });

    compact.addEventListener('change', (event) => {
      if (!event.matches) setOpen(false);
    });
  }
</script>
