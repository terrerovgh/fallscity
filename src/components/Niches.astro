---
import { niches, ui, type Lang } from '../data/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<section class="section" id="for" aria-labelledby="for-title">
  <div class="wrap">
    <header class="section-head">
      <h2 id="for-title">{ui.niches.title[lang]}</h2>
      <p>{ui.niches.lead[lang]}</p>
    </header>
    <ul class="cards">
      {
        niches.map((n) => (
          <li class="reveal">
            <h3>{n.title[lang]}</h3>
            <p>{n.body[lang]}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
