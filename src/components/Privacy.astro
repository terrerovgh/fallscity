---
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { privacyPath, studio, type Lang } from '../data/site';
interface Props { lang: Lang }
const { lang } = Astro.props;

const copy = {
  en: {
    title: 'Privacy',
    updated: 'Last updated: November 17, 2026',
    sections: [
      ['What this site collects', 'This site has no forms, no accounts, no cookies, no analytics and no advertising trackers. It does not collect personal information while you browse.'],
      ['Hosting', 'The site is served by a hosting provider that may keep short-lived technical logs (such as IP address and request time) to deliver the pages and protect against abuse.'],
      ['When you email us', `If you write to ${studio.email}, your message and email address are used only to reply and to discuss your project. They are not sold or shared for marketing.`],
      ['Questions', `Write to ${studio.email} to ask about or delete any message you sent.`],
    ],
  },
  es: {
    title: 'Privacidad',
    updated: 'Última actualización: 17 de noviembre de 2026',
    sections: [
      ['Qué recoge este sitio', 'Este sitio no tiene formularios, cuentas, cookies, analítica ni rastreadores publicitarios. No recoge datos personales mientras navegas.'],
      ['Hosting', 'El sitio lo sirve un proveedor de hosting que puede guardar registros técnicos breves (como la dirección IP y la hora de la petición) para entregar las páginas y protegerlas de abusos.'],
      ['Cuando nos escribes', `Si escribes a ${studio.email}, tu mensaje y tu correo se usan solo para responderte y hablar de tu proyecto. No se venden ni se comparten con fines de marketing.`],
      ['Preguntas', `Escribe a ${studio.email} para consultar o borrar cualquier mensaje que hayas enviado.`],
    ],
  },
}[lang];
---
<Base lang={lang} title={`${copy.title} · ${studio.name}`} description={copy.sections[0]![1]} paths={privacyPath}>
  <Header lang={lang} paths={privacyPath} sections={false} />
  <main id="main" class="section">
    <div class="wrap prose">
      <h1>{copy.title}</h1>
      <p>{copy.updated}</p>
      {
        copy.sections.map(([h, p]) => (
          <>
            <h2>{h}</h2>
            <p>{p}</p>
          </>
        ))
      }
    </div>
  </main>
  <Footer lang={lang} />
</Base>
