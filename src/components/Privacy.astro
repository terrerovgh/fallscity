---
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { inquiry, privacyPath, studio, type Lang } from '../data/site';
interface Props { lang: Lang }
const { lang } = Astro.props;

const copy = {
  en: {
    title: 'Privacy',
    updated: 'Last updated: November 17, 2026',
    sections: [
      ['What this site collects', 'This site has no accounts, no analytics and no advertising trackers. It does not collect personal information while you browse.'],
      ['Cookies', 'The only cookie is a language preference, set when you switch between English and Spanish so the site opens in the language you chose. It holds nothing else.'],
      ...(inquiry.enabled
        ? [
            ['Contact form', 'If you use the contact form, what you type (your name, email, business details and message) is sent to me by email through Resend, an email delivery service. It is not stored in a database on this site. The form uses Cloudflare Turnstile to block spam, which checks technical signals from your browser.'],
          ]
        : []),
      ['Hosting', 'The site is served by Cloudflare, which may keep short-lived technical logs (such as IP address and request time) to deliver the pages and protect against abuse.'],
      ['How your message is used', `Whether you write through the form or to ${studio.email}, your message and email address are used only to reply and to discuss your project. They are not sold or shared for marketing.`],
      ['Questions', `Write to ${studio.email} to ask about or delete any message you sent.`],
    ],
  },
  es: {
    title: 'Privacidad',
    updated: 'Última actualización: 17 de noviembre de 2026',
    sections: [
      ['Qué recoge este sitio', 'Este sitio no tiene cuentas, analítica ni rastreadores publicitarios. No recoge datos personales mientras navegas.'],
      ['Cookies', 'La única cookie es la preferencia de idioma: se guarda cuando cambias entre español e inglés, para que el sitio se abra en el idioma que elegiste. No contiene nada más.'],
      ...(inquiry.enabled
        ? [
            ['Formulario de contacto', 'Si usas el formulario de contacto, lo que escribes (tu nombre, correo, datos del negocio y mensaje) me llega por correo a través de Resend, un servicio de envío de correo. No se guarda en ninguna base de datos de este sitio. El formulario usa Cloudflare Turnstile para bloquear el spam, que revisa señales técnicas de tu navegador.'],
          ]
        : []),
      ['Hosting', 'El sitio lo sirve Cloudflare, que puede guardar registros técnicos breves (como la dirección IP y la hora de la petición) para entregar las páginas y protegerlas de abusos.'],
      ['Cómo se usa tu mensaje', `Escribas por el formulario o a ${studio.email}, tu mensaje y tu correo se usan solo para responderte y hablar de tu proyecto. No se venden ni se comparten con fines de marketing.`],
      ['Preguntas', `Escribe a ${studio.email} para consultar o borrar cualquier mensaje que hayas enviado.`],
    ],
  },
}[lang];
---
<Base lang={lang} title={`${copy.title} · ${studio.name}`} description={copy.sections[0]![1]} paths={privacyPath}>
  <Header lang={lang} paths={privacyPath} />
  <main id="main" class="section">
    <div class="wrap prose">
      <h1>{copy.title}</h1>
      <p>{copy.updated}</p>
      {
        copy.sections.map(([h, p]) => (
          <>
            <h2>{h}</h2>
            <p>{p}</p>
          </>
        ))
      }
    </div>
  </main>
  <Footer lang={lang} />
</Base>
