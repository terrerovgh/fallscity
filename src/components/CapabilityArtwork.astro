---
interface Props {
  variant: 'business' | 'devices' | 'search';
}

const { variant } = Astro.props;
---

<div class={`capability-art capability-art--${variant}`} aria-hidden="true">
  {variant === 'business' && (
    <svg class="capability-art__svg" viewBox="0 0 320 180" fill="none">
      <g class="capability-art__layer-back">
        <rect x="61" y="22" width="214" height="136" rx="10" fill="#c7e6ea" transform="rotate(-5 163 90)" />
        <path d="M73 45L253 23" stroke="#00708a" stroke-opacity=".22" />
      </g>
      <g class="capability-art__layer-front">
        <rect x="39" y="29" width="224" height="130" rx="9" fill="#fbfaf5" stroke="#0d1927" stroke-opacity=".16" />
        <path d="M39 38a9 9 0 0 1 9-9h206a9 9 0 0 1 9 9v17H39V38Z" fill="#0d1927" />
        <circle cx="54" cy="42" r="2.5" fill="#9fd8e6" />
        <circle cx="63" cy="42" r="2.5" fill="#fbfaf5" fill-opacity=".45" />
        <rect x="230" y="39" width="17" height="6" rx="3" fill="#fbfaf5" fill-opacity=".28" />
        <rect x="55" y="70" width="74" height="69" rx="4" fill="#0d1927" />
        <path d="M66 125V99l13-6v32H66Zm19 0V87l17-8v46H85Zm23 0V75l12-5v55h-12Z" fill="#0096b8" />
        <rect x="146" y="74" width="83" height="7" rx="3.5" fill="#0d1927" />
        <rect x="146" y="89" width="67" height="7" rx="3.5" fill="#0d1927" fill-opacity=".76" />
        <rect x="146" y="106" width="91" height="4" rx="2" fill="#3d4b5c" fill-opacity=".26" />
        <rect x="146" y="115" width="77" height="4" rx="2" fill="#3d4b5c" fill-opacity=".26" />
        <rect x="146" y="128" width="42" height="11" rx="5.5" fill="#00708a" />
      </g>
      <g class="capability-art__accent">
        <rect x="238" y="111" width="43" height="43" rx="11" fill="#a44424" transform="rotate(7 259.5 132.5)" />
        <path d="m251 133 7 7 12-17" stroke="#fbfaf5" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
      </g>
    </svg>
  )}

  {variant === 'devices' && (
    <svg class="capability-art__svg" viewBox="0 0 320 180" fill="none">
      <g class="capability-art__desktop">
        <rect x="24" y="38" width="181" height="105" rx="8" fill="#fbfaf5" stroke="#0d1927" stroke-opacity=".2" />
        <path d="M24 46a8 8 0 0 1 8-8h165a8 8 0 0 1 8 8v14H24V46Z" fill="#0d1927" />
        <circle cx="37" cy="49" r="2.5" fill="#9fd8e6" />
        <rect x="38" y="73" width="64" height="53" rx="3" fill="#c7e6ea" />
        <path d="M47 116V93l14-7v30H47Zm20 0V82l23-10v44H67Z" fill="#00708a" />
        <rect x="116" y="76" width="68" height="6" rx="3" fill="#0d1927" />
        <rect x="116" y="89" width="49" height="6" rx="3" fill="#0d1927" fill-opacity=".65" />
        <rect x="116" y="106" width="69" height="4" rx="2" fill="#3d4b5c" fill-opacity=".24" />
        <rect x="116" y="115" width="57" height="4" rx="2" fill="#3d4b5c" fill-opacity=".24" />
        <path d="M103 143v10m-23 4h70l-12-4h-46l-12 4Z" fill="#0d1927" fill-opacity=".7" />
      </g>
      <g class="capability-art__tablet">
        <rect x="163" y="19" width="91" height="137" rx="11" fill="#0d1927" />
        <rect x="168" y="24" width="81" height="127" rx="7" fill="#fbfaf5" />
        <rect x="177" y="35" width="28" height="5" rx="2.5" fill="#0d1927" />
        <rect x="177" y="51" width="63" height="34" rx="3" fill="#c7e6ea" />
        <path d="M184 78V64l10-4v18h-10Zm14 0V57l14-6v27h-14Zm18 0V52l15-5v31h-15Z" fill="#0096b8" />
        <rect x="177" y="96" width="55" height="5" rx="2.5" fill="#0d1927" fill-opacity=".75" />
        <rect x="177" y="108" width="63" height="3" rx="1.5" fill="#3d4b5c" fill-opacity=".25" />
        <rect x="177" y="116" width="48" height="3" rx="1.5" fill="#3d4b5c" fill-opacity=".25" />
        <rect x="177" y="132" width="31" height="9" rx="4.5" fill="#a44424" />
      </g>
      <g class="capability-art__phone">
        <rect x="239" y="64" width="57" height="99" rx="11" fill="#0d1927" />
        <rect x="243" y="68" width="49" height="91" rx="8" fill="#fbfaf5" />
        <rect x="257" y="72" width="21" height="3" rx="1.5" fill="#0d1927" fill-opacity=".3" />
        <rect x="250" y="84" width="35" height="29" rx="3" fill="#0096b8" />
        <path d="M255 106V96l7-3v13h-7Zm10 0V89l8-3v20h-8Zm11 0V85l5-2v23h-5Z" fill="#fbfaf5" />
        <rect x="250" y="121" width="31" height="4" rx="2" fill="#0d1927" fill-opacity=".7" />
        <rect x="250" y="130" width="35" height="3" rx="1.5" fill="#3d4b5c" fill-opacity=".25" />
        <rect x="250" y="138" width="26" height="3" rx="1.5" fill="#3d4b5c" fill-opacity=".25" />
        <rect x="250" y="148" width="20" height="6" rx="3" fill="#a44424" />
      </g>
    </svg>
  )}

  {variant === 'search' && (
    <svg class="capability-art__svg" viewBox="0 0 320 180" fill="none">
      <circle cx="259" cy="43" r="41" fill="#c7e6ea" fill-opacity=".7" />
      <circle cx="259" cy="43" r="29" stroke="#00708a" stroke-opacity=".14" />
      <g class="capability-art__search-bar">
        <rect x="31" y="20" width="251" height="43" rx="21.5" fill="#fbfaf5" stroke="#0d1927" stroke-opacity=".17" />
        <circle cx="54" cy="40" r="7" stroke="#00708a" stroke-width="2" />
        <path d="m59 46 5 5" stroke="#00708a" stroke-width="2" stroke-linecap="round" />
        <rect x="75" y="36" width="93" height="7" rx="3.5" fill="#0d1927" fill-opacity=".7" />
        <rect x="239" y="32" width="29" height="19" rx="9.5" fill="#0d1927" />
        <path d="m249 42 5 5 7-9" stroke="#9fd8e6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </g>
      <g class="capability-art__result capability-art__result--one">
        <rect x="31" y="78" width="251" height="31" rx="6" fill="#fbfaf5" stroke="#00708a" stroke-opacity=".24" />
        <rect x="31" y="78" width="4" height="31" rx="2" fill="#00708a" />
        <rect x="47" y="86" width="14" height="14" rx="4" fill="#0096b8" />
        <rect x="72" y="86" width="89" height="5" rx="2.5" fill="#0d1927" fill-opacity=".74" />
        <rect x="72" y="96" width="137" height="4" rx="2" fill="#3d4b5c" fill-opacity=".22" />
        <rect x="240" y="88" width="24" height="8" rx="4" fill="#c7e6ea" />
      </g>
      <g class="capability-art__result capability-art__result--two">
        <rect x="39" y="117" width="235" height="22" rx="5" fill="#fbfaf5" fill-opacity=".72" />
        <rect x="50" y="123" width="10" height="10" rx="3" fill="#0d1927" fill-opacity=".18" />
        <rect x="70" y="123" width="74" height="4" rx="2" fill="#0d1927" fill-opacity=".38" />
        <rect x="70" y="131" width="121" height="3" rx="1.5" fill="#3d4b5c" fill-opacity=".18" />
      </g>
      <g class="capability-art__result capability-art__result--three">
        <rect x="47" y="146" width="219" height="18" rx="5" fill="#fbfaf5" fill-opacity=".45" />
        <rect x="58" y="151" width="8" height="8" rx="2" fill="#0d1927" fill-opacity=".13" />
        <rect x="76" y="152" width="62" height="4" rx="2" fill="#0d1927" fill-opacity=".25" />
        <rect x="147" y="152" width="72" height="4" rx="2" fill="#3d4b5c" fill-opacity=".14" />
      </g>
      <g class="capability-art__accent">
        <rect x="251" y="91" width="38" height="38" rx="10" fill="#a44424" transform="rotate(8 270 110)" />
        <path d="m262 110 6 6 11-14" stroke="#fbfaf5" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
      </g>
    </svg>
  )}
</div>
