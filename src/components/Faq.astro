---
import { Questions, SectionHeading } from './Site';
import AnimatedContent from './react-bits/AnimatedContent';
import { ui, type Lang } from '../data/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
---
<section id="faq" class="section" aria-labelledby="faq-title">
  <div class="wrap faq">
    <SectionHeading id="faq-title" title={ui.faq.title[lang]} />
    <AnimatedContent client:visible trigger="mount" distance={12} duration={0.55} animateOpacity={false}>
      <Questions lang={lang} />
    </AnimatedContent>
  </div>
</section>
