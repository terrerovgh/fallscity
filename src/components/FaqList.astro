---
import type { Faq } from '../data/faqs';
const { items } = Astro.props as { items: Faq[] };
---
<div class="faq-list">{items.map((item, index) => <details><summary><span class="faq-index">{String(index + 1).padStart(2, '0')}</span><span>{item.question}</span><span class="faq-plus" aria-hidden="true">+</span></summary><div class="faq-answer"><p>{item.answer}</p></div></details>)}</div>
