---
import { Picture } from 'astro:assets';
import { services, shot, tools, ui, type Lang } from '../data/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<section class="section" id="services" aria-labelledby="services-title">
  <div class="wrap">
    <header class="section-head">
      <h2 id="services-title">{ui.services.title[lang]}</h2>
      <p>{ui.services.lead[lang]}</p>
    </header>

    <ul class="services-list">
      {
        services.map((s) => (
          <li class="service reveal">
            <div>
              <h3>{s.title[lang]}</h3>
              <p>{s.body[lang]}</p>
            </div>
            {s.example && (
              <figure class="service-shot">
                <div class="crop">
                  <Picture
                    src={shot(s.example.site, s.example.page, 'desktop')}
                    formats={['avif', 'webp']}
                    widths={[480, 720, 960, 1280]}
                    sizes="(min-width: 56rem) 660px, 92vw"
                    alt=""
                    loading="lazy"
                  />
                </div>
                <figcaption>{s.example.caption[lang]}</figcaption>
              </figure>
            )}
          </li>
        ))
      }
    </ul>

    <div class="tools">
      <h3 class="tools-title">{ui.services.toolsTitle[lang]}</h3>
      <ul class="cards">
        {
          tools.map((t) => (
            <li class="reveal">
              <h4>{t.title[lang]}</h4>
              <p>{t.body[lang]}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
