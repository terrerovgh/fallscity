---
import { SectionHeading, ServiceRows } from './Site';
import AnimatedContent from './react-bits/AnimatedContent';
import { ui, type Lang } from '../data/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
---
<section id="services" class="section" aria-labelledby="services-title">
  <div class="wrap services-layout">
    <SectionHeading id="services-title" title={ui.services.title[lang]} lead={ui.services.lead[lang]} />
    <div>
      <AnimatedContent client:visible trigger="mount" distance={16} duration={0.62} animateOpacity={false}>
        <ServiceRows kind="services" lang={lang} />
      </AnimatedContent>
      <AnimatedContent client:visible trigger="mount" distance={14} duration={0.58} animateOpacity={false} className="service-extra">
        <h3 class="service-extra-title">{ui.services.toolsTitle[lang]}</h3>
        <ServiceRows kind="tools" lang={lang} />
      </AnimatedContent>
    </div>
  </div>
</section>
