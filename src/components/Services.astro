---
import ServiceVisual from './ServiceVisual.astro';
import { SectionHeading } from './Site';
import { services, tools, ui, type Lang } from '../data/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
---
<section id="services" class="section" aria-labelledby="services-title">
  <div class="wrap">
    <SectionHeading id="services-title" title={ui.services.title[lang]} lead={ui.services.lead[lang]} />
    <ul class="service-gallery" role="list">
      {services.map(service => (
        <li class="service-card">
          <ServiceVisual id={service.id} lang={lang} />
          <div class="service-copy">
            <h3>{service.title[lang]}</h3>
            <p>{service.body[lang]}</p>
          </div>
        </li>
      ))}
    </ul>
    <div class="service-extra">
      <h3 class="service-extra-title">{ui.services.toolsTitle[lang]}</h3>
      <ul class="service-gallery service-gallery-compact" role="list">
        {tools.map(service => (
          <li class="service-card">
            <ServiceVisual id={service.id} lang={lang} />
            <div class="service-copy">
              <h4>{service.title[lang]}</h4>
              <p>{service.body[lang]}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
