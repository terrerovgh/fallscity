---
import type { Service } from '../data/services';
import Icon, { type IconName } from './Icon.astro';
import { langFromPath, localizePath, ui } from '../i18n';

interface Props {
  service: Service;
}

const { service } = Astro.props;
const lang = langFromPath(Astro.url.pathname);
const icons: Record<string, IconName> = { '01': 'layout', '02': 'search', '03': 'shield', '04': 'tools' };
---

<article class="service-card reveal-on-scroll">
  <div class="service-card__top">
    <span class="service-card__icon"><Icon name={icons[service.number] ?? 'layout'} /></span>
  </div>
  <h3>{service.title}</h3>
  <p>{service.summary}</p>
  <a class="text-link" href={localizePath(service.href, lang)}>{ui[lang].exploreService}<span class="sr-only">: {service.title}</span></a>
</article>
