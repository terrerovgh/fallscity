---
import EditorialImage from './EditorialImage.astro';
import type { Lang } from '../data/site';

interface Props { id: string; lang: Lang; compact?: boolean }
const { id, lang, compact = false } = Astro.props;

const scenes: Record<string, { en: readonly string[]; es: readonly string[]; sequence?: boolean }> = {
  design: { en: ['Desktop', 'Mobile'], es: ['Escritorio', 'Móvil'] },
  seo: { en: ['Local search', 'Your business'], es: ['Búsqueda local', 'Tu negocio'], sequence: true },
  content: { en: ['Inventory', 'Updated listing'], es: ['Inventario', 'Anuncio actualizado'], sequence: true },
  hosting: { en: ['Domain', 'HTTPS', 'Hosting'], es: ['Dominio', 'HTTPS', 'Hosting'] },
  automation: { en: ['Estimate', 'Quote', 'Invoice'], es: ['Estimación', 'Cotización', 'Factura'], sequence: true },
  clients: { en: ['Inquiry', 'Follow-up', 'Appointment'], es: ['Consulta', 'Seguimiento', 'Cita'], sequence: true },
  messaging: { en: ['Reminder sent'], es: ['Recordatorio enviado'] },
  control: { en: ['Appointments', 'Payments', 'Records'], es: ['Citas', 'Pagos', 'Registros'] },
  care: { en: ['Updates', 'Backups', 'Security'], es: ['Actualizaciones', 'Copias', 'Seguridad'] },
};

const scene = scenes[id];
if (!scene) throw new Error(`Unknown service illustration: ${id}`);
---
<div class:list={['service-visual', `visual-${id}`]} data-visual aria-hidden="true">
  <EditorialImage scene={id} {compact} />
  <div class:list={['visual-legend', { 'visual-sequence': scene.sequence }]}>
    {scene[lang].map(label => <span data-visual-part>{label}</span>)}
  </div>
</div>
