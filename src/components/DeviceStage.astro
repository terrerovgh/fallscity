---
import { Picture } from 'astro:assets';
import { shot, type Project } from '../data/site';

interface Props { project: Project }
const { project } = Astro.props;
const devices = [
  { id: 'desktop', frame: 'laptop', widths: [480, 720, 960, 1280], sizes: '(min-width: 81rem) 480px, (min-width: 52rem) 38vw, 76vw' },
  { id: 'mobile', frame: 'phone', widths: [160, 240, 360, 480], sizes: '(min-width: 81rem) 135px, (min-width: 52rem) 11vw, 22vw' },
] as const;
---
<div class="stage" aria-hidden="true">
  {devices.map(device => (
    <div class={device.frame}>
      {device.id === 'desktop' && (
        <div class="bar">
          <span class="dots"><i></i><i></i><i></i></span>
          <span class="url">{project.domain}</span>
        </div>
      )}
      <div class="screen">
        <div class="screen-track" data-screen-track>
          {project.pages.map(page => (
            <Picture
              src={shot(project.id, page.id, device.id)}
              formats={['avif', 'webp']}
              widths={[...device.widths]}
              sizes={device.sizes}
              alt=""
              loading="lazy"
            />
          ))}
        </div>
      </div>
    </div>
  ))}
</div>
