---
import { site } from '../config/site';
import { absoluteUrl, areaServed, ids, type Alternate, type Crumb, type PageType } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  pathname?: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  pageType?: PageType;
  breadcrumbs?: Crumb[];
  structuredData?: Record<string, unknown>[];
  /** BCP 47 language of the page, e.g. "en-US" or "es-US". */
  lang?: string;
  /** Every language version of this page, including itself. Emits hreflang links. */
  alternates?: Alternate[];
}

const {
  title,
  description,
  pathname = Astro.url.pathname,
  image = '/social-card.png',
  imageAlt = 'Falls City Dev Studio: websites for the businesses that make Louisville work',
  noindex = false,
  pageType = 'WebPage',
  breadcrumbs = [],
  structuredData = [],
  lang = 'en-US',
  alternates = [],
} = Astro.props;

const canonical = absoluteUrl(pathname);
const socialImage = absoluteUrl(image);
const isHome = pathname === '/';
const ogLocale = lang.replace('-', '_');
const ogAlternateLocales = alternates.map((a) => a.hreflang).filter((l) => l !== lang && l !== 'x-default');

// Organization and WebSite are described once, on the homepage (Google's
// recommendation); every other page refers to them by @id.
const siteEntities = isHome
  ? [
      {
        '@type': 'Organization',
        '@id': ids.organization,
        name: site.name,
        url: `${site.url}/`,
        logo: {
          '@type': 'ImageObject',
          url: absoluteUrl('/brand/fallscity-logo.png'),
          width: 1200,
          height: 301,
        },
        description: site.description,
        email: site.email,
        areaServed,
        knowsLanguage: ['en-US', 'es-US'],
        contactPoint: {
          '@type': 'ContactPoint',
          contactType: 'sales',
          email: site.email,
          availableLanguage: ['English', 'Spanish'],
          areaServed,
        },
        // Add profile URLs here (Google Business Profile, Bing Places, etc.)
        // only once they exist and are verified by the owner.
        // sameAs: [],
      },
      {
        '@type': 'WebSite',
        '@id': ids.website,
        url: `${site.url}/`,
        name: site.name,
        publisher: { '@id': ids.organization },
        inLanguage: 'en-US',
      },
    ]
  : [];

const hasTrail = breadcrumbs.length > 1;
const graph = noindex
  ? []
  : [
      ...siteEntities,
      {
        '@type': pageType,
        '@id': `${canonical}#webpage`,
        url: canonical,
        name: title,
        description,
        inLanguage: lang,
        isPartOf: { '@id': ids.website },
        ...(isHome ? { about: { '@id': ids.organization } } : {}),
        ...(hasTrail ? { breadcrumb: { '@id': `${canonical}#breadcrumb` } } : {}),
      },
      ...(hasTrail
        ? [
            {
              '@type': 'BreadcrumbList',
              '@id': `${canonical}#breadcrumb`,
              itemListElement: breadcrumbs.map((crumb, index) => ({
                '@type': 'ListItem',
                position: index + 1,
                name: crumb.name,
                item: absoluteUrl(crumb.path),
              })),
            },
          ]
        : []),
      ...structuredData,
    ];
---

<title>{title}</title>
<meta name="description" content={description} />
{!noindex && <link rel="canonical" href={canonical} />}
{!noindex && alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={absoluteUrl(alt.path)} />)}
<meta name="robots" content={noindex ? 'noindex' : 'index, follow, max-image-preview:large'} />
<meta name="theme-color" content="#0d1927" />
<meta property="og:locale" content={ogLocale} />
{ogAlternateLocales.map((l) => <meta property="og:locale:alternate" content={l.replace('-', '_')} />)}
<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{!noindex && <meta property="og:url" content={canonical} />}
<meta property="og:image" content={socialImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />
<meta name="twitter:image:alt" content={imageAlt} />
{graph.length > 0 && (
  <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })} />
)}
