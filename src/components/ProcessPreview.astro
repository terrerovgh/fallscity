---
import { processSteps } from '../data/process';
import { langFromPath } from '../i18n';

const lang = langFromPath(Astro.url.pathname);
---

<ol class="process-preview">
  {processSteps[lang].map((step) => (
    <li class="process-preview__step reveal-on-scroll">
      <span class="process-preview__number">{step.number}</span>
      <strong>{step.title}</strong>
      <p>{step.summary}</p>
    </li>
  ))}
</ol>
