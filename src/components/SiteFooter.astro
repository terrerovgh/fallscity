---
import { site } from '../config/site';
import { services } from '../data/services';
import { counterpartPath, langFromPath, langTag, localizePath, ui } from '../i18n';

const pathname = Astro.url.pathname;
const lang = langFromPath(pathname);
const t = ui[lang];
const otherLang = lang === 'en' ? 'es' : 'en';
const switchHref = counterpartPath(pathname, otherLang);
const lp = (path: string) => localizePath(path, lang);
import LouisvilleSkyline from './LouisvilleSkyline.astro';
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__grid">
      <div class="site-footer__brand">
        <a class="brand" href={lp('/')} aria-label={t.homeLabel}>
          <img class="brand__logo brand__logo--lg" src="/brand/fallscity-logo.svg" alt="" width="1259" height="316" loading="lazy" />
        </a>
        <p class="site-footer__statement">{t.footerStatement}</p>
      </div>
      <div>
        <h2 class="site-footer__heading">{t.footerExplore}</h2>
        <div class="site-footer__links">
          {t.nav.map((item) => <a href={lp(item.href)}>{item.label}</a>)}
        </div>
      </div>
      <div>
        <h2 class="site-footer__heading">{t.footerServices}</h2>
        <div class="site-footer__links">
          {services[lang].map((service) => <a href={lp(service.href)}>{service.shortTitle}</a>)}
        </div>
      </div>
      <div>
        <h2 class="site-footer__heading">{t.footerStudio}</h2>
        <div class="site-footer__links">
          <a href={lp('/contact/')}>{t.footerQuote}</a>
          <a href={`mailto:${site.email}`}>{site.email}</a>
          <a href={switchHref} hreflang={langTag[otherLang]} lang={langTag[otherLang]} data-lang-switch={otherLang}>{t.footerSwitch}</a>
          <a href={lp('/privacy/')}>{t.footerPrivacy}</a>
          <a href="/sitemap.xml">{t.footerSitemap}</a>
        </div>
      </div>
    </div>
  </div>
  <LouisvilleSkyline variant="footer" />
  <div class="site-footer__river">
    <div class="container site-footer__bottom">
      <span>© {new Date().getFullYear()} Falls City Dev Studio</span>
      <span>{t.footerPlace}</span>
    </div>
  </div>
</footer>
