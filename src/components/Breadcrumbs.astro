---
import type { Crumb } from '../lib/seo';
import { langFromPath, ui } from '../i18n';

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

<nav class="breadcrumbs" aria-label={ui[langFromPath(Astro.url.pathname)].breadcrumb}>
  <ol>
    {items.map((item, index) =>
      index === items.length - 1 ? (
        <li><a href={item.path} aria-current="page">{item.name}</a></li>
      ) : (
        <li><a href={item.path}>{item.name}</a></li>
      ),
    )}
  </ol>
</nav>
