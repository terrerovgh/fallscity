---
import { steps, ui, type Lang } from '../data/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<section class="section" id="process" aria-labelledby="process-title">
  <div class="wrap">
    <header class="section-head">
      <h2 id="process-title">{ui.process.title[lang]}</h2>
    </header>
    <ol class="steps">
      {
        steps.map((s) => (
          <li class="reveal">
            <h3>{s.title[lang]}</h3>
            <p>{s.body[lang]}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
