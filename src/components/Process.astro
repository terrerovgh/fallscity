---
import { ProcessSteps, SectionHeading } from './Site';
import AnimatedContent from './react-bits/AnimatedContent';
import { ui, type Lang } from '../data/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
---
<section id="process" class="section" aria-labelledby="process-title">
  <div class="wrap">
    <SectionHeading id="process-title" title={ui.process.title[lang]} />
    <AnimatedContent client:visible trigger="mount" distance={16} duration={0.65} animateOpacity={false}>
      <ProcessSteps lang={lang} />
    </AnimatedContent>
  </div>
</section>
