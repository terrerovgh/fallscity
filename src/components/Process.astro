---
import { SectionHeading } from './Site';
import EditorialImage from './EditorialImage.astro';
import { steps, ui, type Lang } from '../data/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const scenes = ['discuss', 'build', 'launch'] as const;
---
<section id="process" class="section" aria-labelledby="process-title">
  <div class="wrap">
    <SectionHeading id="process-title" title={ui.process.title[lang]} />
    <ol class="process-steps" data-process-timeline>
      {steps.map((step, index) => (
        <li class="process-step" data-process-step>
          <span class="process-node" aria-hidden="true">{index + 1}</span>
          <div class="process-scene" data-visual aria-hidden="true">
            <EditorialImage scene={scenes[index]} compact />
          </div>
          <h3>{step.title[lang]}</h3>
          <p>{step.body[lang]}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
