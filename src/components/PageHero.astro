---
import { localizePath, type Lang, type RouteKey } from '../i18n';
interface Props { lang: Lang; route: RouteKey; eyebrow: string; title: string; intro: string; tone?: 'paper' | 'blue' | 'dark'; }
const { lang, route, eyebrow, title, intro, tone = 'paper' } = Astro.props;
---
<section class:list={['internal-hero', `tone-${tone}`]} data-route={route}>
  <div class="wrap internal-hero-grid">
    <div class="internal-hero-copy"><p class="eyebrow">{eyebrow}</p><h1>{title}</h1><p class="internal-intro">{intro}</p><div class="button-row"><a class="button button-dark" href={localizePath(lang, 'contact')}>{lang === 'en' ? 'Let’s talk about your site' : 'Hablemos de su web'} ↗</a><slot name="secondary" /></div></div>
    <div class="internal-hero-visual"><slot /></div>
  </div>
</section>
