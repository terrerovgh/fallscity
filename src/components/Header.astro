---
import { SiteHeader } from './Site';
import GradualBlur from './react-bits/GradualBlur';
import type { Lang } from '../data/site';

interface Props { lang: Lang; paths: Record<Lang, string> }
const { lang, paths } = Astro.props;
---
<SiteHeader lang={lang} paths={paths}>
  <GradualBlur position="bottom" height="100%" strength={0.65} layers={4} curve="bezier" zIndex={0} />
</SiteHeader>

<script>
  for (const menu of document.querySelectorAll<HTMLDetailsElement>('.mobile-nav')) {
    menu.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a')) menu.open = false;
    });
    menu.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !menu.open) return;
      menu.open = false;
      menu.querySelector('summary')?.focus();
    });
  }
</script>
