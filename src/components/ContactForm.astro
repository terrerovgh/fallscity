---
import type { Lang } from '../i18n';
import { extras } from '../data/pricing';
import { localizePath } from '../i18n';
const { lang } = Astro.props as { lang: Lang };
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY as string | undefined;
const configured = Boolean(siteKey) && import.meta.env.PUBLIC_INQUIRY_ENABLED === 'true';
const labels = {
  en: { name: 'Your name', email: 'Email address', business: 'Business name (optional)', instagram: 'Instagram (optional)', trade: 'What best describes your business?', booking: 'How do clients book today? (optional)', extras: 'Extras you may want to discuss', description: 'What should your website make easier?', privacy: 'I have read the privacy draft and consent to the information being used to respond to my inquiry.', send: 'Send inquiry', sending: 'Sending…', notConfigured: 'Form delivery is not configured in this local build. The fields are available to review, but submission is disabled. Please email info@fallscity.dev.', success: 'The delivery provider accepted your inquiry. This confirms acceptance for delivery, not arrival in the inbox.', error: 'The inquiry could not be sent. Your entries are still here; please retry or email info@fallscity.dev.', choose: 'Choose one', noBooking: 'Not specified', required: 'Required', optional: 'Optional' },
  es: { name: 'Su nombre', email: 'Correo electrónico', business: 'Nombre del negocio (opcional)', instagram: 'Instagram (opcional)', trade: '¿Qué describe mejor su negocio?', booking: '¿Cómo reservan sus clientes hoy? (opcional)', extras: 'Extras que quizá quiera comentar', description: '¿Qué quiere que su página web facilite?', privacy: 'He leído el borrador de privacidad y acepto que se use la información para responder a mi consulta.', send: 'Enviar consulta', sending: 'Enviando…', notConfigured: 'El envío del formulario no está configurado en esta versión local. Puede revisar los campos, pero el envío está desactivado. Escriba a info@fallscity.dev.', success: 'El proveedor aceptó su consulta para su envío. Esto no confirma que haya llegado al buzón.', error: 'No se pudo enviar la consulta. Sus datos siguen aquí; inténtelo de nuevo o escriba a info@fallscity.dev.', choose: 'Elija una opción', noBooking: 'Sin especificar', required: 'Obligatorio', optional: 'Opcional' },
}[lang];
const trades = { en: [['tattoo-artist', 'Independent tattoo artist'], ['tattoo-studio', 'Tattoo studio'], ['barbershop', 'Barbershop'], ['salon', 'Hair salon'], ['nails', 'Nail salon or artist'], ['piercing', 'Piercing studio'], ['other', 'Other']], es: [['tattoo-artist', 'Tatuador independiente'], ['tattoo-studio', 'Estudio de tatuaje'], ['barbershop', 'Barbería'], ['salon', 'Salón de belleza'], ['nails', 'Salón o artista de uñas'], ['piercing', 'Estudio de piercing'], ['other', 'Otro']] }[lang];
const bookings = { en: [['instagram-dm', 'Instagram messages'], ['booking-app', 'A booking app'], ['phone-text', 'Phone or text'], ['walk-in', 'Walk-ins'], ['other', 'Other']], es: [['instagram-dm', 'Mensajes de Instagram'], ['booking-app', 'Una aplicación de reservas'], ['phone-text', 'Teléfono o mensajes'], ['walk-in', 'Sin cita'], ['other', 'Otro']] }[lang];
---
<form class="inquiry-form" method="post" action="/api/inquiry" data-inquiry-form data-configured={configured ? 'true' : 'false'}>
  <div class:list={['form-availability', { configured }]} role="note">{configured ? (lang === 'en' ? 'Your inquiry is sent securely after anti-spam verification.' : 'Su consulta se envía tras una comprobación contra spam.') : labels.notConfigured}</div>
  <div class="form-grid">
    <label><span>{labels.name}</span><input type="text" name="name" minlength="2" maxlength="80" autocomplete="name" required /></label>
    <label><span>{labels.email}</span><input type="email" name="email" maxlength="254" autocomplete="email" required /></label>
    <label><span>{labels.business}</span><input type="text" name="business" maxlength="120" autocomplete="organization" /></label>
    <label><span>{labels.instagram}</span><input type="text" name="instagram" maxlength="60" autocomplete="off" /></label>
    <label><span>{labels.trade}</span><select name="trade" required><option value="">{labels.choose}</option>{trades.map(([value, label]) => <option value={value}>{label}</option>)}</select></label>
    <label><span>{labels.booking}</span><select name="bookingMethod"><option value="">{labels.noBooking}</option>{bookings.map(([value, label]) => <option value={value}>{label}</option>)}</select></label>
  </div>
  <fieldset class="extras-fieldset"><legend>{labels.extras}</legend><div>{extras[lang].map((extra) => <label><input type="checkbox" name="extras" value={extra.id} /><span>{extra.label}</span></label>)}</div></fieldset>
  <label class="description-field"><span>{labels.description}</span><textarea name="description" minlength="20" maxlength="3000" rows="7" required></textarea><small>{lang === 'en' ? '20–3000 characters. Do not include medical, payment, or other sensitive information.' : '20–3000 caracteres. No incluya información médica, de pagos ni otros datos sensibles.'}</small></label>
  <div class="honeypot" aria-hidden="true"><label>Leave this field empty<input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>
  <input type="hidden" name="startedAt" value="" data-started-at />
  {configured && <div class="cf-turnstile" data-sitekey={siteKey} data-theme="light"></div>}
  <label class="privacy-check"><input type="checkbox" name="privacy" value="true" required /><span>{labels.privacy} <a href={localizePath(lang, 'privacy')}>{lang === 'en' ? 'Read the draft' : 'Leer el borrador'}</a>.</span></label>
  <p class="form-status" role="status" aria-live="polite" data-form-status></p>
  <button class="button button-dark form-submit" type="submit" disabled={!configured}>{configured ? labels.send : (lang === 'en' ? 'Submission not configured' : 'Envío no configurado')}<span aria-hidden="true">↗</span></button>
</form>
{configured && <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
<script>
  const form = document.querySelector<HTMLFormElement>('[data-inquiry-form]');
  const startedAt = document.querySelector<HTMLInputElement>('[data-started-at]');
  if (startedAt) startedAt.value = String(Date.now());
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (form.dataset.configured !== 'true' || !form.reportValidity()) return;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const status = form.querySelector<HTMLElement>('[data-form-status]');
    if (button) button.disabled = true;
    const data = new FormData(form);
    const payload: Record<string, unknown> = Object.fromEntries(data.entries());
    payload.extras = data.getAll('extras');
    payload.privacy = data.get('privacy') === 'true';
    try {
      const response = await fetch('/api/inquiry', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
      const result = await response.json() as { code?: string };
      if (!response.ok) throw new Error(result.code || 'request_failed');
      if (status) { status.textContent = document.documentElement.lang === 'es-US' ? 'El proveedor aceptó su consulta para su envío. Esto no confirma que haya llegado al buzón.' : 'The delivery provider accepted your inquiry. This confirms acceptance for delivery, not arrival in the inbox.'; status.dataset.state = 'success'; }
      form.reset();
    } catch {
      if (status) { status.textContent = document.documentElement.lang === 'es-US' ? 'No se pudo enviar la consulta. Sus datos siguen aquí; inténtelo de nuevo o escriba a info@fallscity.dev.' : 'The inquiry could not be sent. Your entries are still here; please retry or email info@fallscity.dev.'; status.dataset.state = 'error'; }
    } finally {
      if (button) button.disabled = false;
    }
  });
</script>
