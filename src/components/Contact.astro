---
// Contact: the email link always works. The form is rendered hidden and shown by
// src/scripts/inquiry.ts only when the Worker reports that delivery is configured.
import { ContactIntro } from './Site';
import StarBorder from './react-bits/StarBorder';
import { inquiry, privacyPath, studio, ui, type Lang } from '../data/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const mailto = `mailto:${studio.email}?subject=${encodeURIComponent(ui.contact.subject[lang])}&body=${encodeURIComponent(ui.contact.body[lang])}`;
const f = ui.contact.form;
const strings = Object.fromEntries(Object.entries(f.script).map(([k, v]) => [k, v[lang]]));
const optional = `(${f.optional[lang]})`;
---
<section class="section contact" id="contact" aria-labelledby="contact-title">
  <div class="wrap">
    <ContactIntro lang={lang}>
      <StarBorder client:media="(prefers-reduced-motion: no-preference)" as="a" href={mailto}
        className="mail" once duration={1.45} radius={40} thickness={1.5} hover="none" clickPulse={false}
        color="#9fb5ff" trailColor="#416aff" backgroundColor="#19233b" textColor="#f7f8fc" borderColor="#7889b5">
        {studio.email} <span aria-hidden="true">↗</span>
      </StarBorder>
    </ContactIntro>
    <div class="contact-ribbon" aria-hidden="true"></div>

    <div class="inquiry-wrap" data-inquiry-wrap hidden>
      <form class="inquiry" method="post" action="/api/inquiry" novalidate aria-label={f.label[lang]}
        data-inquiry data-sitekey={inquiry.siteKey} data-lang={lang} data-email={studio.email}
        data-subject={ui.contact.subject[lang]} data-strings={JSON.stringify(strings)}>
        <p class="summary" data-summary tabindex="-1" hidden></p>
        <div class="fields">
          <div class="field">
            <label for="f-name">{f.name[lang]}</label>
            <input id="f-name" type="text" name="name" minlength="2" maxlength="80" autocomplete="name" required aria-describedby="e-name" />
            <p class="field-error" id="e-name" hidden></p>
          </div>
          <div class="field">
            <label for="f-email">{f.email[lang]}</label>
            <input id="f-email" type="email" name="email" maxlength="254" autocomplete="email" inputmode="email" spellcheck="false" required aria-describedby="e-email" />
            <p class="field-error" id="e-email" hidden></p>
          </div>
          <div class="field">
            <label for="f-business">{f.business[lang]} <span class="opt">{optional}</span></label>
            <input id="f-business" type="text" name="business" maxlength="120" autocomplete="organization" />
          </div>
          <div class="field">
            <label for="f-city">{f.city[lang]} <span class="opt">{optional}</span></label>
            <input id="f-city" type="text" name="city" maxlength="80" autocomplete="address-level2" />
          </div>
          <div class="field wide">
            <label for="f-links">{f.links[lang]} <span class="opt">{optional}</span></label>
            <input id="f-links" type="text" name="links" maxlength="200" autocomplete="url" spellcheck="false" />
          </div>
          <div class="field wide">
            <label for="f-message">{f.message[lang]}</label>
            <textarea id="f-message" name="message" minlength="20" maxlength="3000" rows="6" required aria-describedby="h-message c-message e-message"></textarea>
            <div class="field-meta">
              <small id="h-message">{f.messageHint[lang]}</small>
              <small id="c-message" class="count" data-count></small>
            </div>
            <p class="field-error" id="e-message" hidden></p>
          </div>
        </div>
        <div class="trap" aria-hidden="true">
          <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
        </div>
        <div class="field">
          <label class="consent">
            <input type="checkbox" name="privacy" value="true" required aria-describedby="e-privacy" />
            <span>{f.privacy[lang]} <a href={privacyPath[lang]}>{f.privacyLink[lang]}</a></span>
          </label>
          <p class="field-error" id="e-privacy" hidden></p>
        </div>
        <div class="turnstile" data-turnstile></div>
        <div class="actions">
          <button class="btn primary send" type="submit">{f.send[lang]}</button>
          <p class="status" role="status" aria-live="polite" data-status></p>
        </div>
        <p class="send-error" data-error tabindex="-1" hidden>
          <span data-error-text></span>
          <a data-error-mail href={mailto}>{f.script.emailInstead[lang]}</a>
        </p>
      </form>

      <div class="sent" data-sent hidden>
        <svg viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="24" r="22" /><path d="M14 25l7 7l13-15" /></svg>
        <h3 tabindex="-1" data-sent-title>{f.script.sentTitle[lang]}</h3>
        <p data-sent-body></p>
        <button class="btn ghost-light" type="button" data-another>{f.script.another[lang]}</button>
      </div>
    </div>
  </div>
</section>

<script>
  import { initInquiry } from '../scripts/inquiry';
  initInquiry();
</script>
