---
import skylineSvg from '../assets/brand/louisville-skyline.svg?raw';

interface Props {
  variant: 'hero' | 'footer';
}

const { variant } = Astro.props;
const artwork = skylineSvg
  .replaceAll('skyline-', `skyline-${variant}-`)
  .replace(
    '<svg ',
    '<svg class="skyline__art" preserveAspectRatio="xMidYMid meet" ',
  );
---

<div class:list={['skyline', `skyline--${variant}`]} aria-hidden="true" set:html={artwork} />
