---
interface Props { href: string }
const { href } = Astro.props;
---
<a class="logo" href={href}>
  <svg viewBox="0 0 32 32" aria-hidden="true">
    <rect width="32" height="32" rx="7" fill="currentColor" />
    <path d="M9 23V9h12M9 16h9" fill="none" stroke="var(--paper)" stroke-width="3" stroke-linecap="square" />
    <path d="M23 18v5" stroke="var(--accent)" stroke-width="3" />
  </svg>
  <span>Falls City <span>Dev Studio</span></span>
</a>
