{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "falls-city-dev-studio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-16",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/*", "!/_astro/*", "!/fonts/*"]
  }
}
